// OrchestratorStatusCard.jsx
import React, { useCallback, useEffect, useState } from 'react';
import ReactFlow, {
  MiniMap,
  Controls,
  Background,
  useNodesState,
  useEdgesState,
  addEdge,
} from 'reactflow';
import 'reactflow/dist/style.css';

const initialNodes = [
  { id: 'Start', position: { x: 300, y: 50 }, data: { label: 'Start' }, style: {} },
  { id: 'Topic Request A', position: { x: 100, y: 150 }, data: { label: 'Topic Request A' }, style: {} },
  { id: 'Orchestrator', position: { x: 300, y: 250 }, data: { label: 'Orchestrator' }, style: {} },
  { id: 'Topic Request Agent', position: { x: 500, y: 150 }, data: { label: 'Topic Request Agent' }, style: {} },
  { id: 'Main Agent', position: { x: 700, y: 250 }, data: { label: 'Main Agent' }, style: {} },
  { id: 'Topic Response Agent', position: { x: 500, y: 350 }, data: { label: 'Topic Response Agent' }, style: {} },
  { id: 'Topic Response A', position: { x: 100, y: 350 }, data: { label: 'Topic Response A' }, style: {} },
];

const stepSequence = [
  { from: null, to: 'Start' },
  { from: 'Start', to: 'Topic Request A' },
  { from: 'Topic Request A', to: 'Orchestrator' },
  { from: 'Orchestrator', to: 'Topic Request Agent' },
  { from: 'Topic Request Agent', to: 'Main Agent' },
  { from: 'Main Agent', to: 'Topic Response Agent' },
  { from: 'Topic Response Agent', to: 'Orchestrator' },
  { from: 'Orchestrator', to: 'Topic Response A' },
  { from: 'Topic Response A', to: 'Start' },
];

const squareNodes = ['Topic Request A', 'Topic Response A', 'Topic Request Agent', 'Topic Response Agent'];

const OrchestratorStatusCard = () => {
  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes);
  const [edges, setEdges, onEdgesChange] = useEdgesState([]);
  const [activeStep, setActiveStep] = useState(0);
  const [nodeStatus, setNodeStatus] = useState({}); // { nodeId: 'inactive' | 'active' | 'completed' }
  const [squareColor, setSquareColor] = useState({}); // { nodeId: 'red' | 'green' | 'blue' }

  const animateNode = useCallback((id) => {
    setNodeStatus((prev) => ({ ...prev, [id]: 'active' }));
    let cycle = ['red', 'green', 'blue'];
    let i = 0;
    const interval = setInterval(() => {
      setSquareColor((prev) => ({ ...prev, [id]: cycle[i % 3] }));
      i++;
    }, 500);

    setTimeout(() => {
      clearInterval(interval);
      setNodeStatus((prev) => ({ ...prev, [id]: 'completed' }));
      setSquareColor((prev) => ({ ...prev, [id]: 'red' }));
    }, 3000);
  }, []);

  useEffect(() => {
    if (activeStep >= stepSequence.length) return;

    const step = stepSequence[activeStep];
    if (step.to) {
      animateNode(step.to);
    }

    if (step.from && step.to) {
      setEdges((eds) =>
        addEdge(
          {
            id: `${step.from}-${step.to}`,
            source: step.from,
            target: step.to,
            animated: true,
            style: { stroke: nodeStatus[step.from] === 'completed' ? 'red' : '#1890ff' },
          },
          eds
        )
      );
    }

    const timer = setTimeout(() => {
      setActiveStep((s) => s + 1);
    }, 3200);

    return () => clearTimeout(timer);
  }, [activeStep]);

  const getNodeStyle = (id) => {
    const status = nodeStatus[id];
    if (status === 'active') return { border: '2px solid #52c41a', background: '#f6ffed' };
    if (status === 'completed') return { border: '2px solid red', background: '#fff1f0' };
    return { border: '1px solid #d9d9d9' };
  };

  const nodeTypes = {
    default: ({ id, data }) => (
      <div style={{ padding: 10, textAlign: 'center' }}>
        <div>{data.label}</div>
        {squareNodes.includes(id) && (
          <div style={{ marginTop: 5, display: 'flex', justifyContent: 'center', gap: 3 }}>
            {[0, 1, 2, 3].map((i) => (
              <div
                key={i}
                style={{
                  width: 8,
                  height: 8,
                  borderRadius: 2,
                  backgroundColor: squareColor[id] || 'lightgrey',
                  transition: 'background-color 0.3s ease',
                }}
              />
            ))}
          </div>
        )}
      </div>
    ),
  };

  const renderedNodes = nodes.map((n) => ({
    ...n,
    data: { ...n.data },
    style: getNodeStyle(n.id),
    type: 'default',
  }));

  return (
    <div style={{ height: '600px', width: '100%' }}>
      <ReactFlow
        nodes={renderedNodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
        nodeTypes={nodeTypes}
      >
        <MiniMap />
        <Controls />
        <Background />
      </ReactFlow>
    </div>
  );
};

export default OrchestratorStatusCard;
