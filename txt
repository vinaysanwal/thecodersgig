import React, { useState, useEffect } from "react";
import { Card, Button } from "antd";
import "./OrchestratorStatusCard.css";

const flowNodes = [
  "Start",
  "Topic Request A",
  "Orchestrator",
  "Topic Request Agent",
  "Main Agent",
  "Topic Response Agent",
  "Orchestrator",
  "Topic Response A",
  "Start",
];

const OrchestratorStatusCard = () => {
  const [currentStep, setCurrentStep] = useState(-1);
  const [running, setRunning] = useState(false);

  useEffect(() => {
    let timer;
    if (running && currentStep < flowNodes.length - 1) {
      timer = setTimeout(() => {
        const nextStep = currentStep + 1;
        console.log("Activating node:", flowNodes[nextStep]);
        setCurrentStep(nextStep);
      }, 3000);
    } else if (currentStep === flowNodes.length - 1) {
      console.log("Flow completed.");
      setRunning(false);
    }

    return () => clearTimeout(timer);
  }, [currentStep, running]);

  const startFlow = () => {
    console.log("Starting flow...");
    setCurrentStep(0);
    setRunning(true);
  };

  const getNodeClass = (label, index) =>
    index === currentStep ? "node active" : "node";

  return (
    <Card title="🧠 Orchestrator Flow" extra={<Button onClick={startFlow}>Start</Button>} className="orchestrator-card">
      <div className="flow-container">
        {/* Top Row */}
        <div className="row top-row">
          <div className={getNodeClass("Start", 0)} id="Start">Start</div>
          <div className={getNodeClass("Topic Request A", 1)} id="TopicRequestA">Topic Request A</div>
          <div className={getNodeClass("Orchestrator", 2)} id="OrchestratorTop">Orchestrator</div>
          <div className={getNodeClass("Topic Request Agent", 3)} id="TopicRequestAgent">Topic Request Agent</div>
          <div className={getNodeClass("Main Agent", 4)} id="MainAgent">Main Agent</div>
        </div>

        {/* Bottom Row */}
        <div className="row bottom-row">
          <div className={getNodeClass("Topic Response Agent", 5)} id="TopicResponseAgent">Topic Response Agent</div>
          <div className={getNodeClass("Orchestrator", 6)} id="OrchestratorBottom">Orchestrator</div>
          <div className={getNodeClass("Topic Response A", 7)} id="TopicResponseA">Topic Response A</div>
          <div className={getNodeClass("Start", 8)} id="StartEnd">Start</div>
        </div>

        {/* Arrows */}
        <svg className="arrow-layer">
          <defs>
            <marker id="arrow" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto" markerUnits="strokeWidth">
              <path d="M0,0 L0,6 L9,3 z" fill="#1890ff" />
            </marker>
          </defs>

          {/* Top row arrows */}
          <line x1="80" y1="40" x2="220" y2="40" className="arrow" />
          <line x1="220" y1="40" x2="360" y2="40" className="arrow" />
          <line x1="360" y1="40" x2="500" y2="40" className="arrow" />
          <line x1="500" y1="40" x2="640" y2="40" className="arrow" />

          {/* Curved arrow from Main Agent (top) to Topic Response Agent (bottom) */}
          <path d="M640,40 C660,80 160,130 160,170" className="arrow" fill="none" />

          {/* Bottom row arrows */}
          <line x1="160" y1="170" x2="300" y2="170" className="arrow" />
          <line x1="300" y1="170" x2="440" y2="170" className="arrow" />
          <line x1="440" y1="170" x2="580" y2="170" className="arrow" />
        </svg>
      </div>
    </Card>
  );
};

export default OrchestratorStatusCard;
