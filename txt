import React, { useRef, useState, useCallback } from 'react';
import ReactFlow, {
  Background,
  Controls,
  useNodesState,
  useEdgesState,
  MarkerType,
} from 'reactflow';
import { Card } from 'antd';
import 'reactflow/dist/style.css';

const nodeBaseStyle = {
  width: 150,
  height: 50,
  backgroundColor: '#f0f0f0',
  border: '1px solid #ccc',
};

const initialNodes = [
  { id: 'start', data: { label: 'Start' }, position: { x: 0, y: 0 }, style: nodeBaseStyle },
  { id: 'topic-request-a', data: { label: 'Topic Request A' }, position: { x: 200, y: 0 }, style: nodeBaseStyle },
  { id: 'orchestrator', data: { label: 'Orchestrator' }, position: { x: 450, y: 0 }, style: nodeBaseStyle },
  { id: 'topic-request-agent', data: { label: 'Topic Request Agent' }, position: { x: 700, y: 0 }, style: nodeBaseStyle },
  { id: 'main-agent', data: { label: 'Main Agent' }, position: { x: 950, y: 0 }, style: nodeBaseStyle },
  { id: 'topic-response-agent', data: { label: 'Topic Response Agent' }, position: { x: 700, y: 120 }, style: nodeBaseStyle },
  { id: 'topic-response-a', data: { label: 'Topic Response A' }, position: { x: 200, y: 120 }, style: nodeBaseStyle },
];

const fullEdges = [
  { id: 'e1', source: 'start', target: 'topic-request-a' },
  { id: 'e2', source: 'topic-request-a', target: 'orchestrator' },
  { id: 'e3', source: 'orchestrator', target: 'topic-request-agent' },
  { id: 'e4', source: 'topic-request-agent', target: 'main-agent' },
  { id: 'e5', source: 'main-agent', target: 'topic-response-agent' },
  { id: 'e6', source: 'topic-response-agent', target: 'orchestrator' },
  { id: 'e7', source: 'orchestrator', target: 'topic-response-a' },
  { id: 'e8', source: 'topic-response-a', target: 'start' },
];

const flowOrder = [
  'start',
  'topic-request-a',
  'orchestrator',
  'topic-request-agent',
  'main-agent',
  'topic-response-agent',
  'orchestrator',
  'topic-response-a',
  'start',
];

const OrchestratorStatusCard = () => {
  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes);
  const [edges, setEdges, onEdgesChange] = useEdgesState([]);
  const stepRef = useRef(0);
  const intervalRef = useRef(null);

  const resetFlow = () => {
    setNodes((nds) =>
      nds.map((node) => ({
        ...node,
        style: { ...node.style, backgroundColor: '#f0f0f0' },
      }))
    );
    setEdges([]); // Hide all edges initially
    stepRef.current = 0;
  };

  const triggerFlow = () => {
    resetFlow();

    intervalRef.current = setInterval(() => {
      const step = stepRef.current;

      if (step >= flowOrder.length - 1) {
        clearInterval(intervalRef.current);

        // Final red node + edge
        const finalNodeId = flowOrder[step];
        const finalEdgeSource = flowOrder[step - 1];
        const finalEdgeTarget = flowOrder[step];

        setNodes((nds) =>
          nds.map((node) =>
            node.id === finalNodeId
              ? { ...node, style: { ...node.style, backgroundColor: '#ffccc7' } }
              : node
          )
        );

        setEdges((eds) =>
          eds.map((edge) =>
            edge.source === finalEdgeSource && edge.target === finalEdgeTarget
              ? { ...edge, animated: false, style: { stroke: '#f5222d' } }
              : edge
          )
        );
        return;
      }

      const current = flowOrder[step];
      const next = flowOrder[step + 1];

      // Set next node to blue (active)
      setNodes((nds) =>
        nds.map((node) => {
          if (node.id === next) {
            return { ...node, style: { ...node.style, backgroundColor: '#bae7ff' } };
          } else if (node.id === current && step > 0) {
            return { ...node, style: { ...node.style, backgroundColor: '#ffccc7' } };
          }
          return node;
        })
      );

      // Add or update edge
      const newEdgeId = `e-${current}-${next}`;
      const newEdge = {
        id: newEdgeId,
        source: current,
        target: next,
        animated: true,
        markerEnd: { type: MarkerType.ArrowClosed },
        style: { stroke: '#1890ff' },
      };

      setEdges((eds) => {
        const prevEdge =
          step > 0
            ? eds.find(
                (e) =>
                  e.source === flowOrder[step - 1] &&
                  e.target === current
              )
            : null;

        const updatedEdges = [...eds];
        if (prevEdge) {
          const index = updatedEdges.findIndex((e) => e.id === prevEdge.id);
          updatedEdges[index] = {
            ...prevEdge,
            animated: false,
            style: { stroke: '#f5222d' },
          };
        }

        return [...updatedEdges, newEdge];
      });

      stepRef.current += 1;
    }, 3000);
  };

  const handleNodeClick = useCallback((_, node) => {
    if (node.id === 'start') {
      triggerFlow();
    }
  }, []);

  return (
    <Card title="Orchestrator Flow" style={{ width: '100%', height: '600px' }}>
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodeClick={handleNodeClick}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
      >
        <Background variant="dots" gap={20} size={1} color="#ccc" />
        <Controls />
      </ReactFlow>
    </Card>
  );
};

export default OrchestratorStatusCard;
