import React, { useEffect, useState } from 'react';
import { Table, Typography, Layout, Spin } from 'antd';
import Header from '../components/Header';
import { getDriftData } from '../services/api';

const { Title } = Typography;
const { Content } = Layout;

const DriftDetection = () => {
  const [data, setData] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    getDriftData('model_v1')
      .then((res) => {
        const driftFeatures = res.data?.drift_features || [];
        const scores = res.data?.drift_scores || {};
        const timestamp = res.data?.timestamp;
        const tableData = driftFeatures.map((feature, i) => ({
          key: i,
          feature,
          score: scores[feature]?.toFixed(2),
          detected_on: timestamp,
        }));
        setData(tableData);
      })
      .finally(() => setLoading(false));
  }, []);

  const columns = [
    { title: 'Feature', dataIndex: 'feature', key: 'feature' },
    { title: 'Drift Score', dataIndex: 'score', key: 'score' },
    { title: 'Detected On', dataIndex: 'detected_on', key: 'detected_on' },
  ];

  return (
    <Layout>
      <Header />
      <Content style={{ padding: 24, maxWidth: 1000, margin: '0 auto' }}>
        <Title level={3}>Drift Detection</Title>
        {loading ? <Spin /> : <Table columns={columns} dataSource={data} />}
      </Content>
    </Layout>
  );
};

export default DriftDetection;





