import { useEffect, useState } from "react";
import "../styles/gfagent.css";

export default function GFAgent() {
  const [traces, setTraces] = useState([]);
  const [selectedTrace, setSelectedTrace] = useState(null);

  useEffect(() => {
    const interval = setInterval(() => {
      const newTrace = {
        id: crypto.randomUUID(),
        status: Math.random() > 0.3 ? "Completed" : "Working",
        time: new Date().toLocaleString(),
        duration: Math.floor(Math.random() * 100) + " ms",
        raw: {
          contextId: crypto.randomUUID(),
          kind: "status-update",
          status: "Task completed successfully.",
          timestamp: new Date().toISOString(),
        },
      };

      setTraces(prev => [newTrace, ...prev.slice(0, 9)]);
    }, 2500);

    return () => clearInterval(interval);
  }, []);

  return (
    <div className="gf-wrapper">
      <div className="gf-header">GF Agent</div>

      <div className="gf-body">

        {/* LEFT PANEL – Agent Running */}
        <div className="gf-left">
          <div className="agent-core">
            🤖
            <div className="agent-status">Running</div>
          </div>
        </div>

        {/* RIGHT PANEL */}
        <div className="gf-right">

          {/* TRACE LIST */}
          <div className="trace-section">
            <div className="trace-title">Live Traces</div>

            <div className="trace-list">
              {traces.map(trace => (
                <div
                  key={trace.id}
                  className={`trace-item ${selectedTrace?.id === trace.id ? "active" : ""}`}
                  onClick={() => setSelectedTrace(trace)}
                >
                  <div className={`status-dot ${trace.status === "Completed" ? "green" : "yellow"}`}></div>

                  <div className="trace-info">
                    <div className="trace-id">
                      {trace.id.slice(0, 20)}
                    </div>
                    <div className="trace-meta">
                      {trace.status} • {trace.time}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* TRACE DETAILS */}
          {selectedTrace && (
            <div className="trace-details">
              <div className="details-header">
                Status {selectedTrace.status}
              </div>

              <div className="details-content">
                <div><strong>Trace ID:</strong> {selectedTrace.id}</div>
                <div><strong>Duration:</strong> {selectedTrace.duration}</div>
                <div><strong>Time:</strong> {selectedTrace.time}</div>

                <div className="raw-box">
                  <pre>
                    {JSON.stringify(selectedTrace.raw, null, 2)}
                  </pre>
                </div>
              </div>
            </div>
          )}

        </div>
      </div>
    </div>
  );




/* RIGHT SIDE SPLIT */
.gf-right {
  flex: 1;
  display: flex;
  gap: 20px;
  padding: 25px;
  overflow: hidden;
}

.trace-section {
  width: 40%;
  overflow-y: auto;
}

.trace-details {
  flex: 1;
  background: rgba(20,20,35,0.7);
  border: 1px solid rgba(0,255,255,0.3);
  border-radius: 14px;
  padding: 20px;
  animation: fadeIn 0.3s ease;
}

.details-header {
  font-size: 18px;
  margin-bottom: 15px;
  text-shadow: 0 0 10px #00ffff;
}

.details-content {
  font-size: 13px;
  line-height: 1.6;
}

.raw-box {
  margin-top: 15px;
  background: #0a0f18;
  padding: 12px;
  border-radius: 8px;
  font-size: 12px;
  overflow-x: auto;
  border: 1px solid rgba(0,255,255,0.2);
}

.trace-item.active {
  border: 1px solid #00ffff;
  box-shadow: 0 0 15px rgba(0,255,255,0.6);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateX(20px); }
  to { opacity: 1; transform: translateX(0); }
}
}
