.flow-wrapper {
  height: 100vh;
  width: 100%;
  position: relative;
  background: radial-gradient(circle at center, #0a0f1c 0%, #05080f 80%);
  color: white;
}

/* TITLE */
.ease-title {
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 42px;
  color: #00f5ff;
  text-shadow: 0 0 20px #00f5ff;
  z-index: 10;
}

/* BOX NODE */
.box-node {
  background: rgba(20, 40, 80, 0.8);
  padding: 20px;
  border-radius: 10px;
  border: 1px solid #00f5ff;
  min-width: 220px;
  box-shadow: 0 0 20px rgba(0, 245, 255, 0.3);
}

/* CIRCLE NODE */
.circle-node {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  background: radial-gradient(circle, #002b45, #000);
  border: 2px solid #00f5ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 25px #00f5ff;
}

.circle-inner {
  text-align: center;
}

.circle-icon {
  font-size: 32px;
}

.circle-title {
  margin-top: 5px;
  font-weight: bold;
}

.circle-status {
  font-size: 12px;
  margin-top: 4px;
}

/* STATUS COLORS */
.circle-node.running {
  border-color: #00ff88;
  box-shadow: 0 0 25px #00ff88;
}

.circle-node.working {
  border-color: #ffc107;
  box-shadow: 0 0 25px #ffc107;
}

.circle-node.idle {
  border-color: #00f5ff;
}

.circle-node.failed {
  border-color: #ff4d4f;
  box-shadow: 0 0 25px #ff4d4f;
}
