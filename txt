import axios from 'axios';

const API_BASE_URL = 'http://localhost:8000'; // Update if different

// Get performance metrics (trend)
export const getPerformanceData = (modelId = 'model_v1') => {
  return axios.get(`${API_BASE_URL}/performance?model_id=${modelId}`);
};

// Get current drift detection results
export const getDriftData = (modelId = 'model_v1') => {
  return axios.get(`${API_BASE_URL}/drift?model_id=${modelId}`);
};

// Get notifications or alerts
export const getNotifications = () => {
  return axios.get(`${API_BASE_URL}/notifications`);
};

// Get past remediation actions
export const getRemediationLog = () => {
  return axios.get(`${API_BASE_URL}/remediation-log`);
};

// Trigger evaluation (orchestrator)
export const runOrchestrator = (modelId = 'model_v1') => {
  return axios.post(`${API_BASE_URL}/run-orchestrator`, { model_id: modelId });
};
