import React, { useState, useEffect } from "react";
import ReactFlow, {
  MiniMap,
  Controls,
  Background,
  useNodesState,
  useEdgesState,
  addEdge,
} from "reactflow";
import "reactflow/dist/style.css";
import { Button } from "antd";

const nodeStyle = {
  padding: 10,
  border: "2px solid #ccc",
  borderRadius: 8,
  textAlign: "center",
  background: "#fff",
  width: 180,
};

const highlightStyle = {
  border: "3px solid #1890ff",
  background: "#e6f7ff",
};

const nodeList = [
  "Start",
  "Topic Request A",
  "Orchestrator",
  "Topic Request Agent",
  "Main Agent",
  "Topic Response Agent",
  "Topic Response A",
];

const flowPath = [
  "Start",
  "Topic Request A",
  "Orchestrator",
  "Topic Request Agent",
  "Main Agent",
  "Topic Response Agent",
  "Orchestrator",
  "Topic Response A",
  "Start",
];

const initialNodes = [
  { id: "Start", data: { label: "Start" }, position: { x: 0, y: 200 }, style: nodeStyle },
  { id: "Topic Request A", data: { label: "Topic Request A" }, position: { x: 200, y: 100 }, style: nodeStyle },
  { id: "Orchestrator", data: { label: "Orchestrator" }, position: { x: 400, y: 200 }, style: nodeStyle },
  { id: "Topic Request Agent", data: { label: "Topic Request Agent" }, position: { x: 600, y: 100 }, style: nodeStyle },
  { id: "Main Agent", data: { label: "Main Agent" }, position: { x: 800, y: 200 }, style: nodeStyle },
  { id: "Topic Response Agent", data: { label: "Topic Response Agent" }, position: { x: 600, y: 300 }, style: nodeStyle },
  { id: "Topic Response A", data: { label: "Topic Response A" }, position: { x: 200, y: 300 }, style: nodeStyle },
];

const initialEdges = [
  { id: "e1", source: "Start", target: "Topic Request A", animated: false },
  { id: "e2", source: "Topic Request A", target: "Orchestrator", animated: false },
  { id: "e3", source: "Orchestrator", target: "Topic Request Agent", animated: false },
  { id: "e4", source: "Topic Request Agent", target: "Main Agent", animated: false },
  { id: "e5", source: "Main Agent", target: "Topic Response Agent", animated: false },
  { id: "e6", source: "Topic Response Agent", target: "Orchestrator", animated: false },
  { id: "e7", source: "Orchestrator", target: "Topic Response A", animated: false },
  { id: "e8", source: "Topic Response A", target: "Start", animated: false },
];

const OrchestratorStatusCard = () => {
  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes);
  const [edges, setEdges, onEdgesChange] = useEdgesState(initialEdges);
  const [step, setStep] = useState(0);
  const [animating, setAnimating] = useState(false);

  useEffect(() => {
    if (!animating) return;

    if (step >= flowPath.length - 1) {
      setAnimating(false);
      return;
    }

    const timer = setTimeout(() => {
      const fromNode = flowPath[step];
      const toNode = flowPath[step + 1];

      // Highlight nodes
      setNodes((nds) =>
        nds.map((node) => ({
          ...node,
          style: {
            ...nodeStyle,
            ...(node.id === toNode ? highlightStyle : {}),
          },
        }))
      );

      // Highlight edges
      setEdges((eds) =>
        eds.map((edge) => ({
          ...edge,
          animated: edge.source === fromNode && edge.target === toNode,
          style:
            edge.source === fromNode && edge.target === toNode
              ? { stroke: "#1890ff", strokeWidth: 2 }
              : { stroke: "#888" },
        }))
      );

      setStep((s) => s + 1);
    }, 3000);

    return () => clearTimeout(timer);
  }, [step, animating]);

  const startAnimation = () => {
    setStep(0);
    setAnimating(true);
  };

  return (
    <div style={{ height: 500, border: "1px solid #ccc", borderRadius: 6 }}>
      <Button onClick={startAnimation} type="primary" style={{ margin: 10 }}>
        Start
      </Button>
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
      >
        <MiniMap />
        <Controls />
        <Background color="#f1f1f1" gap={16} />
      </ReactFlow>
    </div>
  );
};

export default OrchestratorStatusCard;
