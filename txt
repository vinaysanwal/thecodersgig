.custom-node {
  border: 2px solid gray;
  padding: 10px;
  border-radius: 10px;
  background-color: white;
  text-align: center;
  font-weight: bold;
  transition: all 0.3s ease;
}

.custom-node.inactive {
  border-color: gray;
}

.custom-node.active {
  border-color: blue;
}

.custom-node.completed {
  border-color: green;
}

.squares {
  display: flex;
  justify-content: center;
  margin-top: 5px;
}

.square {
  width: 8px;
  height: 8px;
  margin: 2px;
  border-radius: 2px;
  background-color: lightgray;
}

.square.active {
  background-color: blue;
  animation: pulse 1s infinite;
}

.square.completed {
  background-color: green;
}

@keyframes pulse {
  0% { opacity: 0.4; }
  50% { opacity: 1; }
  100% { opacity: 0.4; }
}
