import React from "react";
import {
  ReactFlow,
  Background,
  Controls,
  useNodesState,
  useEdgesState,
  MarkerType,
} from "reactflow";
import { useNavigate } from "react-router-dom";
import "reactflow/dist/style.css";
import "../styles/ease.css";

const initialNodes = [
  {
    id: "datamesh",
    position: { x: 150, y: 120 },
    data: { label: "Data Mesh" },
    className: "flow-node",
  },
  {
    id: "msteams",
    position: { x: 900, y: 120 },
    data: { label: "MS Teams" },
    className: "flow-node",
  },
  {
    id: "observability",
    position: { x: 150, y: 550 },
    data: { label: "Observability" },
    className: "flow-node",
  },
  {
    id: "gfagent",
    position: { x: 900, y: 550 },
    data: { label: "GF Agent" },
    className: "flow-node clickable-node",
  },
  {
    id: "compliance",
    position: { x: 525, y: 730 },
    data: { label: "Compliance" },
    className: "flow-node",
  },
  {
    id: "ease",
    position: { x: 525, y: 360 },
    data: {
      label: (
        <div className="ease-core">
          <div className="ease-core-ring"></div>
          <div className="ease-core-inner">EASE</div>
        </div>
      ),
    },
    className: "ease-node",
  },
];

const initialEdges = [
  "datamesh",
  "msteams",
  "observability",
  "gfagent",
  "compliance",
].map((source, index) => ({
  id: `e${index}`,
  source,
  target: "ease",
  type: "smoothstep",
  animated: true,
  markerEnd: { type: MarkerType.ArrowClosed },
}));

export default function EaseFlow() {
  const navigate = useNavigate();
  const [nodes, , onNodesChange] = useNodesState(initialNodes);
  const [edges, , onEdgesChange] = useEdgesState(initialEdges);

  const handleNodeClick = (_, node) => {
    if (node.id === "gfagent") {
      navigate("/agent/gf-agent");
    }
  };

  return (
    <div className="observability-wrapper">
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodeClick={handleNodeClick}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
      >
        <Background gap={28} size={1} color="rgba(255,255,255,0.05)" />
        <Controls />
      </ReactFlow>
    </div>
  );
}
