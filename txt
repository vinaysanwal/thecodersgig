# backend/orchestrator/config.py

import os
from langchain.chat_models import ChatOpenAI

# ✅ Load Azure OpenAI credentials from environment variables
AZURE_OPENAI_API_KEY = os.getenv("AZURE_OPENAI_API_KEY")
AZURE_OPENAI_ENDPOINT = os.getenv("AZURE_OPENAI_ENDPOINT")
AZURE_DEPLOYMENT_NAME = os.getenv("AZURE_DEPLOYMENT_NAME")  # e.g. "gpt-35-deployment"
AZURE_API_VERSION = os.getenv("AZURE_API_VERSION", "2023-07-01-preview")

# ✅ Azure OpenAI Chat Model (gpt-35-turbo)
llm = ChatOpenAI(
    openai_api_type="azure",
    openai_api_key=AZURE_OPENAI_API_KEY,
    openai_api_base=AZURE_OPENAI_ENDPOINT,
    openai_api_version=AZURE_API_VERSION,
    deployment_name=AZURE_DEPLOYMENT_NAME,
    temperature=0.2,
    model="gpt-35-turbo"
)

# ✅ Shared in-memory state used across LangGraph nodes
SHARED_STATE = {
    "model_id": None,
    "drift_result": None,
    "performance_result": None,
    "remediation_result": None,
}
