import React from 'react';
import './Flow.css';

const Arrow = ({ active, direction = 'right' }) => {
  const isRight = direction === 'right';
  return (
    <svg width="60" height="40" className={`arrow ${active ? 'active' : ''}`}>
      <line
        x1={isRight ? 0 : 60}
        y1="20"
        x2={isRight ? 50 : 10}
        y2="20"
        stroke="black"
        strokeWidth="2"
      />
      <polygon
        points={
          isRight
            ? '50,15 60,20 50,25'
            : '10,15 0,20 10,25'
        }
        fill="black"
      />
    </svg>
  );
};

export default Arrow;

