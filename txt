import axios from 'axios';

const API_BASE_URL = 'http://localhost:8000';

export const getPerformanceData = (modelId = 'model_v1') =>
  axios.get(`${API_BASE_URL}/performance?model_id=${modelId}`);

export const getDriftData = (modelId = 'model_v1') =>
  axios.get(`${API_BASE_URL}/drift?model_id=${modelId}`);

export const getNotifications = () => axios.get(`${API_BASE_URL}/notifications`);

export const getRemediationLog = () => axios.get(`${API_BASE_URL}/remediation-log`);

export const runOrchestrator = (modelId = 'model_v1') =>
  axios.post(`${API_BASE_URL}/run-orchestrator`, { model_id: modelId });


