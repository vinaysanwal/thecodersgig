import React, { useState, useEffect } from "react";
import { Card, Button } from "antd";
import "./OrchestratorStatusCard.css";

const flowNodes = [
  "Start",
  "Topic Request A",
  "Orchestrator",
  "Topic Request Agent",
  "Main Agent",
  "Topic Response Agent",
  "Orchestrator",
  "Topic Response A",
  "Start",
];

const OrchestratorStatusCard = () => {
  const [currentStep, setCurrentStep] = useState(-1);
  const [running, setRunning] = useState(false);

  useEffect(() => {
    let timer;
    if (running && currentStep < flowNodes.length - 1) {
      timer = setTimeout(() => {
        const nextStep = currentStep + 1;
        console.log("Activating node:", flowNodes[nextStep]);
        setCurrentStep(nextStep);
      }, 3000);
    } else if (currentStep === flowNodes.length - 1) {
      console.log("Flow completed.");
      setRunning(false);
    }

    return () => clearTimeout(timer);
  }, [currentStep, running]);

  const startFlow = () => {
    console.log("Starting flow...");
    setCurrentStep(0);
    setRunning(true);
  };

  const getNodeClass = (label, index) =>
    index === currentStep ? "node active" : "node";

  return (
    <Card title="🧠 Orchestrator Flow" extra={<Button onClick={startFlow}>Start</Button>} className="orchestrator-card">
      <div className="flow-container">
        {/* Top Row */}
        <div className="row top-row">
          {["Start", "Topic Request A", "Orchestrator", "Topic Request Agent", "Main Agent"].map((label, i) => (
            <div key={label} className={getNodeClass(label, flowNodes.indexOf(label))}>{label}</div>
          ))}
        </div>

        {/* Arrows */}
        <svg className="arrow-layer">
          <defs>
            <marker id="arrow" markerWidth="10" markerHeight="10" refX="6" refY="3" orient="auto" markerUnits="strokeWidth">
              <path d="M0,0 L0,6 L9,3 z" fill="#1890ff" />
            </marker>
          </defs>
          <line x1="100" y1="40" x2="250" y2="40" className="arrow" />
          <line x1="250" y1="40" x2="400" y2="40" className="arrow" />
          <line x1="400" y1="40" x2="550" y2="40" className="arrow" />
          <line x1="550" y1="40" x2="700" y2="40" className="arrow" />
        </svg>

        {/* Bottom Row */}
        <div className="row bottom-row">
          <div className="spacer" />
          <div className={getNodeClass("Topic Response Agent", flowNodes.indexOf("Topic Response Agent"))}>Topic Response Agent</div>
          <div className={getNodeClass("Orchestrator", 6)}>Orchestrator</div>
          <div className={getNodeClass("Topic Response A", flowNodes.indexOf("Topic Response A"))}>Topic Response A</div>
          <div className={getNodeClass("Start", 8)}>Start</div>
        </div>

        {/* Connecting Line (Main Agent -> Topic Response Agent) */}
        <svg className="curve-layer">
          <path d="M700,40 Q720,100 150,140" stroke="#1890ff" strokeWidth="2" fill="none" markerEnd="url(#arrow)" />
        </svg>

        {/* Arrows in Bottom Row */}
        <svg className="arrow-layer">
          <line x1="150" y1="140" x2="300" y2="140" className="arrow" />
          <line x1="300" y1="140" x2="450" y2="140" className="arrow" />
          <line x1="450" y1="140" x2="600" y2="140" className="arrow" />
        </svg>
      </div>
    </Card>
  );
};

export default OrchestratorStatusCard;
