.home-container {
  min-height: 100vh;
  background: radial-gradient(circle at center, #0f2027, #0b0f1a 60%);
  color: white;
  padding: 40px;
  font-family: "Segoe UI", sans-serif;
}

.ease-title {
  text-align: center;
  font-size: 48px;
  color: #00f5ff;
  margin-bottom: 40px;
  text-shadow: 0 0 20px #00f5ff;
}

.home-layout {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

/* LEFT PANEL */
.left-panel {
  width: 22%;
  display: flex;
  flex-direction: column;
  gap: 30px;
}

.info-box {
  border: 1px solid #00f5ff44;
  padding: 20px;
  border-radius: 12px;
  background: #101a2b;
  box-shadow: 0 0 15px #00f5ff22;
}

.info-box h2 {
  color: #00f5ff;
  margin-bottom: 15px;
}

.info-box ul {
  list-style: none;
  padding: 0;
}

.info-box li {
  margin-bottom: 10px;
  opacity: 0;
  animation: fadeIn 0.8s forwards;
}

.info-box li:nth-child(1) { animation-delay: 0.2s; }
.info-box li:nth-child(2) { animation-delay: 0.4s; }
.info-box li:nth-child(3) { animation-delay: 0.6s; }
.info-box li:nth-child(4) { animation-delay: 0.8s; }
.info-box li:nth-child(5) { animation-delay: 1s; }

/* CENTER PANEL */
.center-panel {
  width: 40%;
  text-align: center;
}

.ease-box {
  border: 2px solid #00f5ff;
  border-radius: 20px;
  padding: 40px;
  position: relative;
  box-shadow: 0 0 40px #00f5ff33;
}

.orchestrator {
  margin-bottom: 30px;
}

.orchestrator-core {
  font-size: 50px;
  animation: pulse 2s infinite;
}

.registry {
  margin: 20px auto;
  padding: 10px 20px;
  border: 1px solid #00f5ff;
  border-radius: 8px;
  display: inline-block;
}

.observability {
  margin-top: 20px;
}

.observability span {
  font-size: 12px;
  color: #ccc;
}

.mcp-box {
  margin-top: 40px;
  border: 2px solid orange;
  padding: 15px;
  border-radius: 10px;
  box-shadow: 0 0 15px orange;
  animation: pulseMCP 3s infinite;
}

.data-layer {
  margin-top: 30px;
  display: flex;
  justify-content: center;
  gap: 20px;
}

.data-item {
  padding: 10px 20px;
  background: #0d1b2a;
  border: 1px solid #00f5ff44;
  border-radius: 8px;
}

/* RIGHT PANEL */
.right-panel {
  width: 25%;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.agent-card {
  display: flex;
  align-items: center;
  padding: 15px;
  border-radius: 12px;
  background: #101a2b;
  transition: 0.3s;
  border: 1px solid #00f5ff33;
}

.agent-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 0 20px #00f5ff55;
}

.agent-icon {
  font-size: 30px;
  margin-right: 15px;
}

.agent-card.running {
  border-left: 5px solid #00ff88;
}

.agent-card.working {
  border-left: 5px solid #ffc107;
}

.agent-card.idle {
  border-left: 5px solid #00f5ff;
}

.agent-card.failed {
  border-left: 5px solid #ff4d4f;
}

.status {
  font-size: 12px;
  text-transform: uppercase;
}

/* Animations */
@keyframes pulse {
  0% { text-shadow: 0 0 10px #00f5ff; }
  50% { text-shadow: 0 0 30px #00f5ff; }
  100% { text-shadow: 0 0 10px #00f5ff; }
}

@keyframes pulseMCP {
  0% { box-shadow: 0 0 10px orange; }
  50% { box-shadow: 0 0 30px orange; }
  100% { box-shadow: 0 0 10px orange; }
}

@keyframes fadeIn {
  to { opacity: 1; }
}

export default Home;
