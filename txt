from orchestrator.nodes.drift_node import detect_drift
from orchestrator.nodes.performance_node import evaluate_performance
from orchestrator.nodes.remediation_node import suggest_remediation
from orchestrator.nodes.decision_node import decide_next_action
from orchestrator.config import SHARED_STATE

import asyncio

def log_state(stage: str, state: dict):
    print(f"===== {stage.upper()} =====")
    for k, v in state.items():
        print(f"{k}: {v}")
    print("========================\n")

async def run_graph(model_id: str) -> dict:
    """
    Main LangGraph-style flow executor.
    Handles state mutation and LLM-powered decision making.
    """
    # ✅ Initialize state
    SHARED_STATE.clear()
    SHARED_STATE.update({"model_id": model_id})

    # ✅ Step 1: Detect Drift
    drift_result = detect_drift(model_id)
    SHARED_STATE["drift_result"] = drift_result
    log_state("Drift Detection", SHARED_STATE)

    # ✅ Step 2: Evaluate Performance
    performance_result = evaluate_performance(model_id)
    SHARED_STATE["performance_result"] = performance_result
    log_state("Performance Evaluation", SHARED_STATE)

    # ✅ Step 3: LLM Decision Node
    decision = decide_next_action(SHARED_STATE)
    SHARED_STATE["decision"] = decision
    log_state("Decision", SHARED_STATE)

    # ✅ Step 4: Optional Remediation
    if decision == "remediate":
        remediation_result = suggest_remediation(SHARED_STATE)
        SHARED_STATE["remediation_result"] = remediation_result
        log_state("Remediation", SHARED_STATE)

    return SHARED_STATE
