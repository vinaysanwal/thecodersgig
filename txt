import numpy as np
from scipy.stats import ks_2samp

def get_drift_data(model_id: str):
    # Simulated reference and live data
    np.random.seed(42)
    reference_data = np.random.normal(0, 1, 500)
    live_data = np.random.normal(0.1, 1.2, 500)

    p_value = ks_2samp(reference_data, live_data).pvalue
    drift_detected = p_value < 0.05

    drift_scores = {
        "feature_1": 1 - p_value  # Example for one feature
    }

    return {
        "model_id": model_id,
        "drift_features": ["feature_1"] if drift_detected else [],
        "drift_scores": drift_scores
    }


