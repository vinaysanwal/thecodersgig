import React, { useEffect, useRef } from "react";
import "./home.css";
import { gsap } from "gsap";

export default function Home() {
  const pulseRef = useRef(null);
  const pathRef = useRef(null);

  useEffect(() => {
    // Continuous subtle data stream
    gsap.to(".stream-path", {
      strokeDashoffset: -1000,
      duration: 15,
      repeat: -1,
      ease: "linear"
    });

    // Slow MCP glow breathing
    gsap.to(".mcp-box", {
      boxShadow: "0 0 30px #E30613",
      duration: 2,
      repeat: -1,
      yoyo: true
    });

  }, []);

  const triggerFlow = () => {
    const path = pathRef.current;
    const length = path.getTotalLength();

    const pulse = pulseRef.current;

    gsap.set(pulse, { opacity: 1 });

    gsap.fromTo(
      pulse,
      { motionPath: { path: path, align: path } },
      {
        motionPath: { path: path, align: path },
        duration: 2,
        ease: "power2.inOut",
        onComplete: () => gsap.set(pulse, { opacity: 0 })
      }
    );

    gsap.fromTo(
      ".agent-ring",
      { boxShadow: "0 0 10px #E30613" },
      {
        boxShadow: "0 0 40px #E30613",
        duration: 0.8,
        yoyo: true,
        repeat: 1
      }
    );
  };

  return (
    <div className="ease-container">

      <h1 className="title">EASE</h1>

      <div className="layout">

        {/* LEFT INPUT PANEL */}
        <div className="inputs">
          <h3>INPUTS</h3>
          <div className="input-card" onClick={triggerFlow}>
            Human (Click to Trigger)
          </div>
          <div className="input-card">API</div>
          <div className="input-card">Agents</div>
        </div>

        {/* CENTER CORE */}
        <div className="core">
          <div className="ease-circle">EASE</div>
          <div className="box">Orchestrator</div>
          <div className="box">Agent Registry</div>
          <div className="box small">
            Observability — Logs • Traces • Monitoring
          </div>
          <div className="box mcp-box">MCP</div>
          <div className="db">Data Mesh / DB</div>

          <svg className="svg-layer">
            <path
              ref={pathRef}
              className="stream-path"
              d="M 100 200 C 300 150 500 250 700 200"
              stroke="#E30613"
              strokeWidth="2"
              fill="none"
              strokeDasharray="10 10"
            />

            <circle
              ref={pulseRef}
              r="6"
              fill="#E30613"
              opacity="0"
            />
          </svg>
        </div>

        {/* RIGHT AGENTS */}
        <div className="agents">
          <div className="agent-ring">PAT Agent<br />RUNNING</div>
          <div className="agent-ring idle">Compliance<br />IDLE</div>
          <div className="agent-ring working">Risk Analyst<br />WORKING</div>
          <div className="agent-ring failed">Report Gen<br />FAILED</div>
        </div>

      </div>

      {/* METRICS SECTION */}
      <div className="metrics">

        <div className="metric-card">
          <h4>Evaluations Agent</h4>
          <ul>
            <li>Risk assessments</li>
            <li>Pattern analysis</li>
            <li>Event scoring</li>
          </ul>
        </div>

        <div className="metric-card">
          <h4>Risk Analyst Agent</h4>
          <ul>
            <li>Suspicious detection</li>
            <li>Escalation logic</li>
            <li>Market insights</li>
          </ul>
        </div>

        <div className="metric-card">
          <h4>PAT Agent</h4>
          <ul>
            <li>Compliance scoring</li>
            <li>Monitoring rules</li>
            <li>Alert triggers</li>
          </ul>
        </div>

      </div>

    </div>
  );
}
