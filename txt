.custom-node {
  padding: 12px;
  border: 2px solid #999;
  border-radius: 6px;
  background: #fff;
  font-weight: 500;
  text-align: center;
  min-width: 120px;
}

.custom-node.active {
  border-color: blue;
}

.custom-node.completed {
  border-color: green;
}

.squares {
  display: flex;
  justify-content: center;
  gap: 4px;
  margin-top: 5px;
}

.square {
  width: 10px;
  height: 10px;
  border-radius: 2px;
  background-color: grey;
}

.square.active {
  background-color: blue;
  animation: blink 1s infinite;
}

.square.completed {
  background-color: green;
}

@keyframes blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}
