2) Explain closures with an example.
Answer:
A closure is formed when a function remembers the variables from its lexical scope even after the outer function has closed.

function outer() {
  let count = 0;
  return function inner() {
    count++;
    return count;
  };
}
const counter = outer();
counter(); // 1
