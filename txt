import React from "react";
import {
  ReactFlow,
  Background,
  Controls,
  useNodesState,
  useEdgesState,
  MarkerType,
} from "reactflow";
import { useNavigate } from "react-router-dom";
import "reactflow/dist/style.css";
import "../styles/ease.css";

const initialNodes = [
  {
    id: "datamesh",
    position: { x: 150, y: 100 },
    data: { label: "Data Mesh" },
    className: "cyber-node flow-node",
  },
  {
    id: "msteams",
    position: { x: 900, y: 100 },
    data: { label: "MS Teams" },
    className: "cyber-node flow-node",
  },
  {
    id: "observability",
    position: { x: 150, y: 550 },
    data: { label: "Observability" },
    className: "cyber-node flow-node",
  },
  {
    id: "gfagent",
    position: { x: 900, y: 550 },
    data: { label: "GF Agent" },
    className: "cyber-node flow-node clickable-node",
  },
  {
    id: "compliance",
    position: { x: 525, y: 720 },
    data: { label: "Compliance" },
    className: "cyber-node flow-node",
  },
  {
    id: "ease",
    position: { x: 525, y: 350 },
    data: {
      label: (
        <div className="ai-core-enhanced">
          <div className="core-ripple"></div>
          🤖
          <div>EASE</div>
        </div>
      ),
    },
    className: "ai-node-enhanced",
  },
];

const initialEdges = [
  "datamesh",
  "msteams",
  "observability",
  "gfagent",
  "compliance",
].map((source, i) => ({
  id: `e${i}`,
  source,
  target: "ease",
  type: "smoothstep",
  animated: true,
  markerEnd: { type: MarkerType.ArrowClosed },
  className: "neon-edge",
}));

export default function EaseFlow() {
  const navigate = useNavigate();
  const [nodes, , onNodesChange] = useNodesState(initialNodes);
  const [edges, , onEdgesChange] = useEdgesState(initialEdges);

  const handleNodeClick = (_, node) => {
    if (node.id === "gfagent") {
      navigate("/agent/gf-agent");
    }
  };

  return (
    <div className="cyber-wrapper enhanced-bg">
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodeClick={handleNodeClick}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
      >
        <Background gap={25} size={1} color="rgba(0,255,255,0.1)" />
        <Controls />
      </ReactFlow>
    </div>
  );
}






/* ============================= */
/* ENHANCED BACKGROUND */
/* ============================= */

.enhanced-bg {
  background: radial-gradient(circle at center, #0f2027, #05070d);
  animation: bgPulse 6s infinite alternate;
}

@keyframes bgPulse {
  0% { filter: brightness(1); }
  100% { filter: brightness(1.1); }
}

/* ============================= */
/* ENHANCED AI CORE */
/* ============================= */

.ai-node-enhanced {
  padding: 30px;
  border-radius: 50%;
  background: radial-gradient(circle, #00ffff22, #000);
  border: 2px solid #00ffff;
  box-shadow: 0 0 60px #00ffff;
}

.ai-core-enhanced {
  position: relative;
  font-size: 28px;
  text-align: center;
  animation: corePulse 2s infinite ease-in-out;
}

@keyframes corePulse {
  0% { text-shadow: 0 0 20px #00ffff; }
  50% { text-shadow: 0 0 60px #00ffff; }
  100% { text-shadow: 0 0 20px #00ffff; }
}

.core-ripple {
  position: absolute;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  border: 2px solid #00ffff;
  top: -40px;
  left: -30px;
  animation: ripple 3s infinite;
  opacity: 0.4;
}

@keyframes ripple {
  0% { transform: scale(0.7); opacity: 0.6; }
  100% { transform: scale(1.6); opacity: 0; }
}

/* ============================= */
/* FLOWING DATA EFFECT */
/* ============================= */

.neon-edge .react-flow__edge-path {
  stroke: #00ffff;
  stroke-width: 2;
  filter: drop-shadow(0 0 8px #00ffff);
}

.react-flow__edge.animated path {
  stroke-dasharray: 6;
  animation: dashFlow 1s linear infinite;
}

@keyframes dashFlow {
  to { stroke-dashoffset: -12; }
}

/* Simulated data packet glow */
.react-flow__edge path::after {
  content: "";
  position: absolute;
  width: 6px;
  height: 6px;
  background: #00ffff;
  border-radius: 50%;
  animation: packetMove 2s linear infinite;
}

@keyframes packetMove {
  from { transform: translateX(0); }
  to { transform: translateX(100px); }
}

/* ============================= */
/* FLOW NODE ACTIVE PULSE */
/* ============================= */

.flow-node {
  animation: nodeGlow 3s infinite alternate;
}

@keyframes nodeGlow {
  0% { box-shadow: 0 0 15px rgba(0,255,255,0.3); }
  100% { box-shadow: 0 0 35px rgba(0,255,255,0.8); }
}
