from orchestrator.utils import load_live_data

def evaluate_performance(model_id: str) -> dict:
    """
    Evaluate model performance based on latest live data.
    Returns latency and accuracy, and flags if degraded.
    """
    try:
        live_data = load_live_data(model_id)
        trend = live_data.get("trend", [])

        if not trend:
            return {
                "degraded": False,
                "latency": None,
                "accuracy": None,
                "message": "No performance trend data found."
            }

        latest = trend[-1]  # Most recent entry
        latency = latest.get("latency", 0)
        accuracy = latest.get("accuracy", 1)

        return {
            "degraded": (latency > 500 or accuracy < 0.8),
            "latency": latency,
            "accuracy": accuracy
        }

    except Exception as e:
        return {
            "degraded": False,
            "latency": None,
            "accuracy": None,
            "error": str(e)
        }




