from agents.remediation_agent import suggest_fix

@app.post("/remediation")
async def remediation_action(request: Request):
    try:
        body = await request.json()
        model_id = body.get("model_id", "model_v1")
        drift_result = body.get("drift_result") or SHARED_STATE.get("drift_result", {})
        performance_result = body.get("performance_result") or SHARED_STATE.get("performance_result", {})

        result = suggest_fix(drift_result, performance_result, model_id)
        return JSONResponse(content=result)

    except Exception as e:
        return JSONResponse(status_code=500, content={"error": str(e)})
