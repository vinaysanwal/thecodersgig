import os
import json
from typing import Dict, Any, List

# Base data folder (adjust if needed)
BASE_DIR = os.path.join(os.path.dirname(__file__), "..", "data")

def get_model_list() -> List[Dict[str, Any]]:
    """Load all models from models.json"""
    models_path = os.path.join(BASE_DIR, "models.json")
    if not os.path.exists(models_path):
        raise FileNotFoundError("models.json not found in /data/")
    
    with open(models_path, "r") as f:
        return json.load(f)

def load_reference_data(model_id: str) -> Dict[str, Any]:
    """Load reference data for a specific model"""
    path = os.path.join(BASE_DIR, "reference", f"{model_id}.json")
    if not os.path.exists(path):
        raise FileNotFoundError(f"Reference data not found for model: {model_id}")
    
    with open(path, "r") as f:
        return json.load(f)

def load_live_data(model_id: str) -> Dict[str, Any]:
    """Load live data for a specific model"""
    path = os.path.join(BASE_DIR, "live", f"{model_id}.json")
    if not os.path.exists(path):
        raise FileNotFoundError(f"Live data not found for model: {model_id}")
    
    with open(path, "r") as f:
        return json.load(f)

def get_model_metadata(model_id: str) -> Dict[str, Any]:
    """Return metadata for a specific model from models.json"""
    models = get_model_list()
    for model in models:
        if model["model_id"] == model_id:
            return model
    raise ValueError(f"Model {model_id} not found in models.json")
