import { useNavigate } from "react-router-dom";
import "../styles/landing.css";

export default function Landing() {
  const navigate = useNavigate();

  const agents = [
    "Observability Agent",
    "Brokerage Agent",
    "Disclosure Agent",
    "Compliance Agent",
    "Risk Agent",
    "Analytics Agent",
    "Audit Agent",
    "Orchestration Agent",
  ];

  return (
    <div className="landing-wrapper">
      <h1 className="ease-header">EASE</h1>

      <div className="agent-grid">
        {agents.map((agent, index) => (
          <div
            key={index}
            className="agent-card"
            onClick={() => navigate("/observability")}
          >
            {agent}
          </div>
        ))}
      </div>
    </div>
  );
}


landing.css::


.landing-wrapper {
  height: 100vh;
  background: radial-gradient(circle at center, #0f2027, #090a0f);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60px;
  color: white;
}

/* Header Animation */
.ease-header {
  font-size: 80px;
  letter-spacing: 10px;
  margin-bottom: 60px;
  animation: glowPulse 2s infinite ease-in-out;
}

@keyframes glowPulse {
  0% {
    text-shadow: 0 0 15px #00ffff;
  }
  50% {
    text-shadow: 0 0 40px #00ffff, 0 0 70px #00ffff;
  }
  100% {
    text-shadow: 0 0 15px #00ffff;
  }
}

/* Grid Layout */
.agent-grid {
  display: grid;
  grid-template-columns: repeat(4, 220px);
  gap: 30px;
}

/* Cards */
.agent-card {
  height: 140px;
  background: rgba(20, 20, 35, 0.7);
  border-radius: 18px;
  border: 1px solid rgba(0, 255, 255, 0.4);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 20px;
  cursor: pointer;
  transition: 0.3s ease;
  box-shadow: 0 0 20px rgba(0, 255, 255, 0.15);
}

/* Hover Glow */
.agent-card:hover {
  transform: translateY(-10px) scale(1.05);
  box-shadow: 0 0 35px rgba(0, 255, 255, 0.7);
}

/* Floating Animation */
.agent-card:nth-child(odd) {
  animation: float 3s infinite ease-in-out;
}

.agent-card:nth-child(even) {
  animation: floatReverse 3s infinite ease-in-out;
}

@keyframes float {
  0% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
  100% { transform: translateY(0); }
}

@keyframes floatReverse {
  0% { transform: translateY(-5px); }
  50% { transform: translateY(5px); }
  100% { transform: translateY(-5px); }
}

