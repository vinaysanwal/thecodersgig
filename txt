import React, { useState, useEffect } from 'react';
import FlowBox from './FlowBox';
import Arrow from './Arrow';
import './Flow.css';

const topRow = [
  'Start',
  'Topic Request A',
  'Orchestrator',
  'Topic Request Agent',
  'Main Agent',
];

const bottomRow = [
  'Topic Response Agent',
  'Orchestrator',
  'Topic Response A',
  'Start',
];

const OrchestratorFlow = () => {
  const [activeIndex, setActiveIndex] = useState(0);
  const totalSteps = topRow.length + bottomRow.length;

  useEffect(() => {
    const interval = setInterval(() => {
      setActiveIndex((prev) => (prev + 1) % totalSteps);
    }, 1000);
    return () => clearInterval(interval);
  }, []);

  return (
    <div className="flow-2rows">
      <div className="flow-row">
        {topRow.map((step, index) => (
          <React.Fragment key={index}>
            <FlowBox title={step} />
            {index < topRow.length - 1 && (
              <Arrow active={activeIndex === index} direction="right" />
            )}
          </React.Fragment>
        ))}
      </div>

      <div className="flow-row reverse">
        {bottomRow.map((step, index) => (
          <React.Fragment key={index}>
            <FlowBox title={step} />
            {index < bottomRow.length - 1 && (
              <Arrow
                active={activeIndex === topRow.length + index}
                direction="left"
              />
            )}
          </React.Fragment>
        ))}
      </div>
    </div>
  );
};

export default OrchestratorFlow;

