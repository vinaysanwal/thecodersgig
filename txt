  <Card title={title} style={{ marginTop: 16 }}>
    <List
      dataSource={['log_1', 'log_2', 'log_3']}
      renderItem={(item) => (
        <List.Item>
          <Skeleton active title={false} paragraph={{ rows: 1 }} loading={false}>
            {item}
          </Skeleton>
        </List.Item>
      )}
    />
  </Card>
);

export default LogsPanel;
