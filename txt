import { useNavigate } from "react-router-dom";
import { useEffect, useState } from "react";
import "../styles/landing.css";

const AGENTS = [
  "Observability Agent",
  "Brokerage Agent",
  "Disclosure Agent",
  "Compliance Agent",
  "Risk Agent",
  "Analytics Agent",
  "Audit Agent",
  "Orchestration Agent",
];

export default function Landing() {
  const navigate = useNavigate();
  const [stats, setStats] = useState([]);

  useEffect(() => {
    const generateStats = () =>
      AGENTS.map(() => ({
        running: Math.floor(Math.random() * 10) + 1,
        queue: Math.floor(Math.random() * 20),
        success: Math.floor(Math.random() * 10) + 90,
      }));

    setStats(generateStats());
    const interval = setInterval(() => {
      setStats(generateStats());
    }, 3000);

    return () => clearInterval(interval);
  }, []);

  return (
    <div className="landing-page">
      {/* HEADER */}
      <div className="landing-header">
        <div className="brand-left">UBS</div>
        <div className="brand-divider">|</div>
        <div className="brand-right">EASE</div>
      </div>

      {/* CENTER HERO BOX */}
      <div className="hero-container">
        <div className="hero-box">
          <div className="hero-ring"></div>
          <div className="hero-core">EASE</div>
        </div>
      </div>

      {/* AGENT GRID */}
      <div className="agent-grid">
        {AGENTS.map((agent, index) => (
          <div
            key={agent}
            className="agent-card"
            onClick={() => navigate("/observability")}
          >
            <div className="agent-title">{agent}</div>

            {stats[index] && (
              <div className="agent-stats">
                <div className="stat">
                  <span>{stats[index].running}</span>
                  <label>Running</label>
                </div>
                <div className="stat">
                  <span>{stats[index].queue}</span>
                  <label>Queue</label>
                </div>
                <div className="stat">
                  <span>{stats[index].success}%</span>
                  <label>Success</label>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  );
}
