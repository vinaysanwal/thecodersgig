import React, { useEffect, useState } from 'react';
import {
  Row,
  Col,
  Typography,
  Layout,
  Spin,
  Select,
  Button,
  message,
  Card,
  Table,
  Tag,
  Space,
} from 'antd';
import Header from '../components/Header';
import StatusCard from '../components/StatusCard';
import PerformanceChart from '../components/PerformanceChart';
import NotificationPanel from '../components/NotificationPanel';
import {
  getPerformanceData,
  getNotifications,
  getDriftData,
  runOrchestrator,
} from '../services/api';

const { Title } = Typography;
const { Content } = Layout;
const { Option } = Select;

const Dashboard = () => {
  const [performance, setPerformance] = useState([]);
  const [notifications, setNotifications] = useState([]);
  const [driftData, setDriftData] = useState({});
  const [loading, setLoading] = useState(true);
  const [selectedModel, setSelectedModel] = useState('model_v1');

  useEffect(() => {
    fetchData();
  }, [selectedModel]);

  const fetchData = () => {
    setLoading(true);
    Promise.all([
      getPerformanceData(selectedModel),
      getNotifications(),
      getDriftData(selectedModel),
    ])
      .then(([perfRes, notifRes, driftRes]) => {
        setPerformance(perfRes.data.trend || []);
        setNotifications(notifRes.data || []);
        setDriftData(driftRes.data || {});
      })
      .catch(console.error)
      .finally(() => setLoading(false));
  };

  const handleRunEvaluation = async () => {
    try {
      const res = await runOrchestrator(selectedModel);
      message.success('Evaluation complete!');
      fetchData();
    } catch (err) {
      message.error('Failed to run evaluation.');
    }
  };

  const columns = [
    {
      title: 'Feature',
      dataIndex: 'feature',
      key: 'feature',
    },
    {
      title: 'Drift Score',
      dataIndex: 'score',
      key: 'score',
    },
    {
      title: 'Status',
      dataIndex: 'status',
      key: 'status',
      render: (status) => (
        <Tag color={status === 'Drift' ? 'red' : 'green'}>{status}</Tag>
      ),
    },
    {
      title: 'Detected On',
      dataIndex: 'detected_on',
      key: 'detected_on',
    },
    {
      title: 'Action',
      key: 'action',
      render: () => <Button type="link">Trigger Fix</Button>,
    },
  ];

  const tableData = (driftData?.drift_features || []).map((feature, idx) => ({
    key: idx,
    feature,
    score: driftData?.drift_scores?.[feature]?.toFixed(2) || '-',
    status: 'Drift',
    detected_on: driftData?.timestamp || 'N/A',
  }));

  return (
    <Layout style={{ minHeight: '100vh', background: '#f0f2f5' }}>
      <Header />
      <Content style={{ padding: '24px 32px', maxWidth: '1400px', margin: '0 auto' }}>
        <Card style={{ marginBottom: 24 }}>
          <Row justify="space-between" align="middle">
            <Title level={3} style={{ marginBottom: 0 }}>ML Observatory</Title>
            <Space>
              <Select value={selectedModel} onChange={setSelectedModel} style={{ width: 150 }}>
                <Option value="model_v1">Model v1</Option>
                <Option value="model_v2">Model v2</Option>
                <Option value="model_v3">Model v3</Option>
              </Select>
              <Button type="primary" onClick={handleRunEvaluation}>
                Run Evaluation
              </Button>
            </Space>
          </Row>
        </Card>

        <Row gutter={16}>
          <Col span={8}><StatusCard title="Model Health" status="Healthy ✅" /></Col>
          <Col span={8}><StatusCard title="Drift Detected" status={driftData?.drift_detected ? 'Yes ⚠️' : 'No ✅'} /></Col>
          <Col span={8}><StatusCard title="Last Fix" status="2 hours ago" /></Col>
        </Row>

        <Row gutter={16} style={{ marginTop: 24 }}>
          <Col span={14}>
            <Card title="Model Performance Over Time">
              {loading ? <Spin /> : <PerformanceChart data={performance} />}
            </Card>
          </Col>
          <Col span={10}>
            <Card title="Notifications">
              {loading ? <Spin /> : <NotificationPanel notifications={notifications} />}
            </Card>
          </Col>
        </Row>

        <Card title="Drift Detection" style={{ marginTop: 24 }}>
          <Table
            columns={columns}
            dataSource={tableData}
            pagination={false}
            loading={loading}
          />
        </Card>
      </Content>
    </Layout>
  );
};

export default Dashboard;
