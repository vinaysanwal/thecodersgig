# orchestrator/nodes/decision_node.py
from orchestrator.config import llm

def decide_next_action(state):
    prompt = f"""
    A model was evaluated with the following:
    - Drift detected: {state['drift_result']['drift_detected']}
    - Features with drift: {state['drift_result']['drift_features']}
    - Performance accuracy: {state['performance_result']['accuracy']}

    Should we trigger remediation? Reply with 'remediate' or 'end'.
    """
    response = llm.invoke(prompt)
    return "remediate" if "remediate" in response.content.lower() else "end"

# orchestrator/langgraph_orchestrator.py
from orchestrator.nodes import drift_node, performance_node, remediation_node, decision_node
from orchestrator.config import SHARED_STATE

async def run_graph(model_id):
    SHARED_STATE["model_id"] = model_id
    SHARED_STATE["drift_result"] = drift_node.detect_drift(model_id)
    SHARED_STATE["performance_result"] = performance_node.evaluate_performance(model_id)

    next_action = decision_node.decide_next_action(SHARED_STATE)

    if next_action == "remediate":
        SHARED_STATE["remediation_result"] = remediation_node.suggest_remediation(SHARED_STATE)

    return SHARED_STATE

