import React, { useCallback, useEffect, useRef, useState } from 'react';
import ReactFlow, {
  Background,
  useNodesState,
  useEdgesState,
  addEdge,
} from 'reactflow';
import 'reactflow/dist/style.css';
import './styles.css'; // Add appropriate class colors here

const initialNodes = [
  { id: 'start', data: { label: 'Start' }, position: { x: 300, y: 0 }, className: 'node' },
  { id: 'topicRequestA', data: { label: 'Topic Request A' }, position: { x: 100, y: 100 }, className: 'node' },
  { id: 'topicRequestAgent', data: { label: 'Topic Request Agent' }, position: { x: 500, y: 100 }, className: 'node' },
  { id: 'orchestrator', data: { label: 'Orchestrator' }, position: { x: 300, y: 180 }, className: 'node' },
  { id: 'mainAgent', data: { label: 'Main Agent' }, position: { x: 700, y: 100 }, className: 'node' },
  { id: 'topicResponseA', data: { label: 'Topic Response A' }, position: { x: 100, y: 280 }, className: 'node' },
  { id: 'topicResponseAgent', data: { label: 'Topic Response Agent' }, position: { x: 500, y: 280 }, className: 'node' },
];

const flowSequence = [
  ['start', 'topicRequestA'],
  ['topicRequestA', 'orchestrator'],
  ['orchestrator', 'topicRequestAgent'],
  ['topicRequestAgent', 'mainAgent'],
  ['mainAgent', 'topicResponseAgent'],
  ['topicResponseAgent', 'orchestrator'],
  ['orchestrator', 'topicResponseA'],
  ['topicResponseA', 'start'],
];

const createNodeComponent = (label, status = 'inactive') => (
  <div className={`custom-node ${status}`}>
    {label}
    <div className="squares">
      {[1, 2, 3, 4].map((i) => (
        <div key={i} className={`square ${status}`} />
      ))}
    </div>
  </div>
);

const OrchestratorFlow = () => {
  const [nodes, setNodes, onNodesChange] = useNodesState(
    initialNodes.map((n) => ({
      ...n,
      data: {
        label: createNodeComponent(n.data.label),
      },
    }))
  );
  const [edges, setEdges, onEdgesChange] = useEdgesState([]);
  const [currentStep, setCurrentStep] = useState(0);
  const [isAnimating, setIsAnimating] = useState(false);
  const intervalRef = useRef(null);

  const resetFlow = () => {
    setNodes((nds) =>
      nds.map((n) => ({
        ...n,
        data: {
          label: createNodeComponent(n.data.label.props.children[0], 'inactive'),
        },
      }))
    );
    setEdges([]);
    setCurrentStep(0);
  };

  const startAnimation = () => {
    if (isAnimating) return;
    setIsAnimating(true);
    resetFlow();
  };

  useEffect(() => {
    if (!isAnimating) return;

    if (currentStep >= flowSequence.length) {
      setIsAnimating(false);
      return;
    }

    const [sourceId, targetId] = flowSequence[currentStep];

    // Set active and completed node states
    setNodes((nds) =>
      nds.map((n) => {
        if (n.id === sourceId) {
          return {
            ...n,
            data: {
              label: createNodeComponent(n.data.label.props.children[0], 'completed'),
            },
          };
        } else if (n.id === targetId) {
          return {
            ...n,
            data: {
              label: createNodeComponent(n.data.label.props.children[0], 'active'),
            },
          };
        }
        return n;
      })
    );

    // Add animated edge
    setEdges((eds) => [
      ...eds,
      {
        id: `${sourceId}-${targetId}`,
        source: sourceId,
        target: targetId,
        animated: true,
        style: { stroke: '#00f', strokeWidth: 2 }, // blue animation
        markerEnd: {
          type: 'arrowclosed',
        },
      },
    ]);

    intervalRef.current = setTimeout(() => {
      // Change animated edge to green (completed)
      setEdges((eds) =>
        eds.map((e) =>
          e.id === `${sourceId}-${targetId}`
            ? {
                ...e,
                animated: false,
                style: { stroke: '#0f0', strokeWidth: 2 }, // green after animation
              }
            : e
        )
      );

      // Target node completed
      setNodes((nds) =>
        nds.map((n) =>
          n.id === targetId
            ? {
                ...n,
                data: {
                  label: createNodeComponent(n.data.label.props.children[0], 'completed'),
                },
              }
            : n
        )
      );

      setCurrentStep((step) => step + 1);
    }, 3000);

    return () => clearTimeout(intervalRef.current);
  }, [currentStep, isAnimating]);

  const onNodeClick = useCallback(
    (_, node) => {
      if (node.id === 'start') startAnimation();
    },
    [startAnimation]
  );

  return (
    <div style={{ height: '700px', width: '100%' }}>
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
        onNodeClick={onNodeClick}
      >
        <Background variant="dots" gap={12} size={1} color="#aaa" />
      </ReactFlow>
    </div>
  );
};

export default OrchestratorFlow;
