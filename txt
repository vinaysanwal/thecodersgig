import os
import json

PERFORMANCE_PATH = "data/performance"

def load_json(path):
    with open(path, "r") as f:
        return json.load(f)

def get_performance_data(model_id: str) -> dict:
    try:
        file_path = os.path.join(PERFORMANCE_PATH, f"{model_id}.json")
        if not os.path.exists(file_path):
            raise FileNotFoundError(f"Performance data not found for {model_id}")

        data = load_json(file_path)
        trend = data.get("trend", [])

        return {
            "model_id": model_id,
            "trend": trend
        }

    except Exception as e:
        return {
            "model_id": model_id,
            "error": str(e),
            "trend": []
        }
