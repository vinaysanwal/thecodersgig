// frontend/src/components/DriftTable.jsx
import React from 'react';
import { Table, Tag } from 'antd';

const DriftTable = ({ data }) => {
  const columns = [
    {
      title: 'Feature',
      dataIndex: 'feature',
      key: 'feature',
    },
    {
      title: 'Drift Score',
      dataIndex: 'score',
      key: 'score',
    },
    {
      title: 'Status',
      dataIndex: 'status',
      key: 'status',
      render: (status) => (
        <Tag color={status.includes('❌') ? 'red' : 'green'}>{status}</Tag>
      )
    }
  ];
  return <Table dataSource={data} columns={columns} pagination={false} rowKey="feature" />;
};

export default DriftTable;


// frontend/src/components/PerformanceChart.jsx
import React from 'react';
import { Line } from '@ant-design/charts';

const PerformanceChart = ({ data }) => {
  const formattedData = data.flatMap(({ time, accuracy, latency }) => [
    { time, value: accuracy, type: 'Accuracy' },
    { time, value: latency, type: 'Latency' }
  ]);

  const config = {
    data: formattedData,
    xField: 'time',
    yField: 'value',
    seriesField: 'type',
    height: 250,
    color: ['#3b82f6', '#f97316'],
    smooth: true,
    point: {
      size: 4,
      shape: 'circle',
    },
    tooltip: {
      showMarkers: true,
    },
  };

  return <Line {...config} />;
};

export default PerformanceChart;


