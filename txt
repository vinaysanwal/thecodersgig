import React, { useState, useEffect } from 'react';
import ReactFlow, {
  ReactFlowProvider,
  addEdge,
  MiniMap,
  Controls,
  Background,
} from 'react-flow-renderer';
import { Button, Card } from 'antd';
import './orchestrator.css';

const initialNodes = [
  { id: 'start', data: { label: 'Start' }, position: { x: 0, y: 0 } },
  { id: 'topicRequestA', data: { label: 'Topic Request A' }, position: { x: 200, y: 0 } },
  { id: 'orchestrator', data: { label: 'Orchestrator' }, position: { x: 400, y: 0 } },
  { id: 'topicRequestAgent', data: { label: 'Topic Request Agent' }, position: { x: 600, y: 0 } },
  { id: 'mainAgent', data: { label: 'Main Agent' }, position: { x: 800, y: 0 } },
  { id: 'topicResponseAgent', data: { label: 'Topic Response Agent' }, position: { x: 600, y: 150 } },
  { id: 'topicResponseA', data: { label: 'Topic Response A' }, position: { x: 400, y: 150 } },
];

const fullSequence = [
  ['start', 'topicRequestA'],
  ['topicRequestA', 'orchestrator'],
  ['orchestrator', 'topicRequestAgent'],
  ['topicRequestAgent', 'mainAgent'],
  ['mainAgent', 'topicResponseAgent'],
  ['topicResponseAgent', 'orchestrator'],
  ['orchestrator', 'topicResponseA'],
  ['topicResponseA', 'start'],
];

const OrchestratorStatusCard = () => {
  const [nodes, setNodes] = useState(initialNodes.map((node) => ({
    ...node,
    style: { border: '2px solid gray', borderRadius: 8, padding: 10 },
    data: { ...node.data, status: 'inactive' }
  })));

  const [edges, setEdges] = useState([]);
  const [step, setStep] = useState(0);
  const [isRunning, setIsRunning] = useState(false);

  const updateNodeStatus = (id, status) => {
    setNodes((nds) =>
      nds.map((node) =>
        node.id === id
          ? {
              ...node,
              data: { ...node.data, status },
              style: {
                ...node.style,
                border: status === 'active' ? '2px solid green' : status === 'done' ? '2px solid red' : '2px solid gray',
              },
            }
          : node
      )
    );
  };

  useEffect(() => {
    if (!isRunning || step >= fullSequence.length) return;

    const [from, to] = fullSequence[step];

    updateNodeStatus(from, 'done');
    updateNodeStatus(to, 'active');

    setEdges((eds) => [
      ...eds,
      {
        id: `${from}-${to}`,
        source: from,
        target: to,
        animated: true,
        style: { stroke: 'green' },
        data: { status: 'active' },
      },
    ]);

    const timer = setTimeout(() => {
      setEdges((eds) =>
        eds.map((edge) =>
          edge.id === `${from}-${to}`
            ? {
                ...edge,
                animated: false,
                style: { stroke: 'red' },
                data: { status: 'done' },
              }
            : edge
        )
      );
      updateNodeStatus(to, 'done');
      setStep((prev) => prev + 1);
    }, 3000);

    return () => clearTimeout(timer);
  }, [step, isRunning]);

  const handleStart = () => {
    setNodes(initialNodes.map((node) => ({
      ...node,
      style: { border: '2px solid gray', borderRadius: 8 },
      data: { ...node.data, status: node.id === 'start' ? 'active' : 'inactive' }
    })));
    setEdges([]);
    setStep(0);
    setIsRunning(true);
  };

  const customNode = ({ data, id }) => {
    const status = data.status || 'inactive';
    const color = status === 'active' ? 'green' : status === 'done' ? 'red' : 'gray';

    return (
      <div style={{
        background: 'white',
        padding: 10,
        borderRadius: 8,
        border: `2px solid ${color}`,
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'space-between',
        minWidth: 120,
        position: 'relative',
      }}>
        <div>{data.label}</div>
        <div style={{
          width: 12,
          height: 12,
          background: color,
          borderRadius: '50%',
          marginLeft: 8
        }} />
        {id === 'start' && (
          <Button
            size="small"
            type="primary"
            onClick={handleStart}
            style={{ position: 'absolute', top: -30, left: 0 }}
          >
            Start
          </Button>
        )}
      </div>
    );
  };

  return (
    <Card title="Orchestrator Flow" style={{ height: '600px' }}>
      <ReactFlowProvider>
        <ReactFlow
          elements={[...nodes.map((node) => ({ ...node, type: 'custom' })), ...edges]}
          nodeTypes={{ custom: customNode }}
          fitView
        >
          <MiniMap />
          <Controls />
          <Background variant="dots" gap={20} size={1} />
        </ReactFlow>
      </ReactFlowProvider>
    </Card>
  );
};

export default OrchestratorStatusCard;
