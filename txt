.reactflow-wrapper {
  height: 100vh;
  background: radial-gradient(circle at center, #0a0f1c 0%, #05080f 80%);
  color: white;
}

.ease-title {
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 48px;
  color: #00f5ff;
  text-shadow: 0 0 30px #00f5ff;
  z-index: 10;
}

/* GLASS NODE */
.glass-node {
  background: rgba(20, 40, 80, 0.6);
  padding: 20px;
  border-radius: 12px;
  border: 1px solid #00f5ff;
  box-shadow: 0 0 20px rgba(0, 245, 255, 0.4);
  min-width: 200px;
}

/* CIRCLE NODE */
.circle-node {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  border: 2px solid #00f5ff;
  background: radial-gradient(circle, #001f2f, #000);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 25px #00f5ff;
  position: relative;
}

.circle-inner {
  text-align: center;
}

.circle-icon {
  font-size: 30px;
  margin-bottom: 5px;
}

.circle-label {
  font-weight: bold;
}

.circle-status {
  font-size: 12px;
  display: block;
  margin-top: 4px;
}

/* STATUS COLORS */
.circle-node.running {
  border-color: #00ff88;
  box-shadow: 0 0 25px #00ff88;
}

.circle-node.working {
  border-color: #ffc107;
  box-shadow: 0 0 25px #ffc107;
}

.circle-node.idle {
  border-color: #00f5ff;
}

.circle-node.failed {
  border-color: #ff4d4f;
  box-shadow: 0 0 25px #ff4d4f;
}
