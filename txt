import React, { useCallback, useEffect, useRef, useState } from 'react';
import ReactFlow, {
  MiniMap,
  Controls,
  Background,
  useNodesState,
  useEdgesState,
} from 'reactflow';
import { Button, Card } from 'antd';
import 'reactflow/dist/style.css';

const flowOrder = [
  'start',
  'topicRequestA',
  'orchestrator',
  'topicRequestAgent',
  'mainAgent',
  'topicResponseAgent',
  'orchestrator',
  'topicResponseA',
  'start',
];

const baseNodes = [
  { id: 'start', position: { x: 0, y: 100 }, data: { label: 'Start' } },
  { id: 'topicRequestA', position: { x: 200, y: 100 }, data: { label: 'Topic Request A' } },
  { id: 'orchestrator', position: { x: 400, y: 100 }, data: { label: 'Orchestrator' } },
  { id: 'topicRequestAgent', position: { x: 600, y: 100 }, data: { label: 'Topic Request Agent' } },
  { id: 'mainAgent', position: { x: 800, y: 100 }, data: { label: 'Main Agent' } },
  { id: 'topicResponseAgent', position: { x: 600, y: 250 }, data: { label: 'Topic Response Agent' } },
  { id: 'topicResponseA', position: { x: 200, y: 250 }, data: { label: 'Topic Response A' } },
];

const baseEdges = [
  { id: 'e1', source: 'start', target: 'topicRequestA' },
  { id: 'e2', source: 'topicRequestA', target: 'orchestrator' },
  { id: 'e3', source: 'orchestrator', target: 'topicRequestAgent' },
  { id: 'e4', source: 'topicRequestAgent', target: 'mainAgent' },
  { id: 'e5', source: 'mainAgent', target: 'topicResponseAgent' },
  { id: 'e6', source: 'topicResponseAgent', target: 'orchestrator' },
  { id: 'e7', source: 'orchestrator', target: 'topicResponseA' },
  { id: 'e8', source: 'topicResponseA', target: 'start' },
];

const OrchestratorStatusCard = () => {
  const [nodes, setNodes, onNodesChange] = useNodesState(baseNodes);
  const [edges, setEdges, onEdgesChange] = useEdgesState(baseEdges);
  const [activeStep, setActiveStep] = useState(-1);
  const intervalRef = useRef(null);

  const resetAllNodes = () => {
    setNodes((nds) =>
      nds.map((node) => ({
        ...node,
        style: { ...node.style, border: '1px solid #ddd', background: '#fff' },
      }))
    );
  };

  const highlightNode = (id) => {
    setNodes((nds) =>
      nds.map((node) =>
        node.id === id
          ? {
              ...node,
              style: {
                ...node.style,
                border: '2px solid #1890ff',
                background: '#e6f7ff',
              },
            }
          : {
              ...node,
              style: { ...node.style, border: '1px solid #ddd', background: '#fff' },
            }
      )
    );
  };

  const startFlow = () => {
    resetAllNodes();
    setActiveStep(0);
  };

  useEffect(() => {
    if (activeStep >= 0 && activeStep < flowOrder.length) {
      highlightNode(flowOrder[activeStep]);
      intervalRef.current = setTimeout(() => {
        setActiveStep((prev) => prev + 1);
      }, 3000);
    }

    if (activeStep >= flowOrder.length) {
      setActiveStep(-1); // Stop the animation
    }

    return () => clearTimeout(intervalRef.current);
  }, [activeStep]);

  return (
    <Card
      title="Orchestrator Flow"
      extra={<Button type="primary" onClick={startFlow}>Start</Button>}
      style={{ height: '600px' }}
    >
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
      >
        <MiniMap />
        <Controls />
        <Background variant="lines" gap={16} size={1} />
      </ReactFlow>
    </Card>
  );
};

export default OrchestratorStatusCard;


.react-flow__node {
  border-radius: 6px;
  padding: 8px;
  transition: all 0.3s ease-in-out;
}
