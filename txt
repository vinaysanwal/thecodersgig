import React from 'react';
import { Layout, Typography, Row, Col } from 'antd';
import UserCard from './components/UserCard';
import UserRequestBox from './components/UserRequestBox';
import OrchestratorStatusCard from './components/OrchestratorStatusCard';
import AgentGroupCard from './components/AgentGroupCard';
import LogsPanel from './components/LogsPanel';

const { Header, Content } = Layout;
const { Title } = Typography;

const App = () => {
  return (
    <Layout style={{ minHeight: '100vh' }}>
      <Header style={{ backgroundColor: '#001529', padding: '0 20px' }}>
        <Title level={3} style={{ color: 'white', margin: 0 }}>
          Dashboard
        </Title>
      </Header>

      <Content style={{ padding: 20 }}>
        <Row gutter={[16, 16]}>
          {/* Left Side */}
          <Col span={6}>
            <UserCard />
            <UserRequestBox />
            <LogsPanel title="Observability" />
          </Col>

          {/* Center Area */}
          <Col span={12}>
            <OrchestratorStatusCard />
            <LogsPanel title="Observability" />
          </Col>

          {/* Right Side */}
          <Col span={6}>
            <AgentGroupCard />
          </Col>
        </Row>
      </Content>
    </Layout>
  );
};

export default App;
