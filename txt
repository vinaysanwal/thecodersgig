# orchestrator/nodes/drift_node.py
import pandas as pd
from agents.drift_agent import run as run_drift_agent

def drift_node(state: dict) -> dict:
    reference_path = state.get("reference_data", "data/reference.csv")
    live_path = state.get("live_data", "data/live.csv")

    drift_results = run_drift_agent(reference_path, live_path)
    state.update(drift_results)
    state["last_step"] = "drift"
    return state


# orchestrator/nodes/performance_node.py
import pandas as pd
from agents.performance_agent import run as run_performance_agent

def performance_node(state: dict) -> dict:
    predictions_path = state.get("predictions_data", "data/predictions.csv")
    performance_results = run_performance_agent(predictions_path)
    state.update(performance_results)
    state["last_step"] = "performance"
    return state


# orchestrator/nodes/remediation_node.py
from agents.remediation_agent import run as run_remediation_agent

def remediation_node(state: dict) -> dict:
    remediation_plan = run_remediation_agent(state)
    state["remediation_plan"] = remediation_plan
    state["last_step"] = "remediation"
    return state


# orchestrator/nodes/decision_node.py
def decision_node(state: dict) -> str:
    if "remediation_plan" in state:
        return "end"
    if state.get("drift_detected"):
        return "drift"
    if state.get("performance_issues"):
        return "performance"
    return "remediation"
