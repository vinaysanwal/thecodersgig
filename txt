from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

app = FastAPI()

# Allow CORS for React frontend
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # or ["http://localhost:5173"] for Vite
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.get("/api/drift")
def get_drift():
    return [
        {"feature": "age", "score": 0.12, "status": "❌ Drift"},
        {"feature": "income", "score": 0.03, "status": "✅ Stable"},
        {"feature": "location", "score": 0.15, "status": "❌ Drift"},
    ]

@app.get("/api/performance")
def get_performance():
    return [
        {"time": "10:00", "accuracy": 0.92, "latency": 280},
        {"time": "11:00", "accuracy": 0.89, "latency": 300},
        {"time": "12:00", "accuracy": 0.85, "latency": 340},
    ]

@app.get("/api/notifications")
def get_notifications():
    return [
        "⚠️ Drift detected in model_v3",
        "✅ Patch applied for latency spike",
        "⚠️ Feature importance shift noticed",
    ]

@app.get("/api/remediation")
def get_remediation():
    return [
        {"issue": "Drift in age", "action": "Re-trained model", "status": "Completed"},
        {"issue": "Latency spike", "action": "Scaled infra", "status": "In Progress"},
    ]
