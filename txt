import React, { useCallback, useEffect, useRef, useState } from 'react';
import ReactFlow, {
  MiniMap,
  Controls,
  Background,
  addEdge,
  useNodesState,
  useEdgesState
} from 'reactflow';
import 'reactflow/dist/style.css';
import { Button, Card } from 'antd';

const initialNodes = [
  { id: 'start', position: { x: 0, y: 100 }, data: { label: 'Start' }, type: 'default' },
  { id: 'topicRequestA', position: { x: 200, y: 100 }, data: { label: 'Topic Request A' }, type: 'default' },
  { id: 'orchestrator', position: { x: 400, y: 100 }, data: { label: 'Orchestrator' }, type: 'default' },
  { id: 'topicRequestAgent', position: { x: 600, y: 100 }, data: { label: 'Topic Request Agent' }, type: 'default' },
  { id: 'mainAgent', position: { x: 800, y: 100 }, data: { label: 'Main Agent' }, type: 'default' },
  { id: 'topicResponseAgent', position: { x: 600, y: 250 }, data: { label: 'Topic Response Agent' }, type: 'default' },
  { id: 'topicResponseA', position: { x: 200, y: 250 }, data: { label: 'Topic Response A' }, type: 'default' },
];

const initialEdges = [
  { id: 'e1', source: 'start', target: 'topicRequestA' },
  { id: 'e2', source: 'topicRequestA', target: 'orchestrator' },
  { id: 'e3', source: 'orchestrator', target: 'topicRequestAgent' },
  { id: 'e4', source: 'topicRequestAgent', target: 'mainAgent' },
  { id: 'e5', source: 'mainAgent', target: 'topicResponseAgent' },
  { id: 'e6', source: 'topicResponseAgent', target: 'orchestrator' },
  { id: 'e7', source: 'orchestrator', target: 'topicResponseA' },
  { id: 'e8', source: 'topicResponseA', target: 'start' },
];

const OrchestratorStatusCard = () => {
  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes);
  const [edges, setEdges, onEdgesChange] = useEdgesState(initialEdges);
  const [activeIndex, setActiveIndex] = useState(-1);

  const nodeOrder = [
    'start',
    'topicRequestA',
    'orchestrator',
    'topicRequestAgent',
    'mainAgent',
    'topicResponseAgent',
    'orchestrator',
    'topicResponseA',
    'start'
  ];

  const intervalRef = useRef(null);

  const resetNodeStyles = () => {
    setNodes((nds) =>
      nds.map((node) => ({
        ...node,
        className: '',
      }))
    );
  };

  const highlightNode = (id) => {
    setNodes((nds) =>
      nds.map((node) => ({
        ...node,
        className: node.id === id ? 'active-node' : '',
      }))
    );
  };

  const startAnimation = () => {
    resetNodeStyles();
    setActiveIndex(0);
  };

  useEffect(() => {
    if (activeIndex >= 0 && activeIndex < nodeOrder.length) {
      highlightNode(nodeOrder[activeIndex]);

      intervalRef.current = setTimeout(() => {
        setActiveIndex((prev) => prev + 1);
      }, 3000);
    }

    return () => clearTimeout(intervalRef.current);
  }, [activeIndex]);

  return (
    <Card
      title="Orchestrator Status Flow"
      extra={<Button onClick={startAnimation} type="primary">Start</Button>}
      style={{ width: '100%', height: '600px' }}
    >
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
      >
        <MiniMap />
        <Controls />
        <Background variant="dots" gap={12} size={1} />
      </ReactFlow>
    </Card>
  );
};

export default OrchestratorStatusCard;
