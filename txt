# orchestrator/nodes/drift_node.py
import json
from scipy.stats import ks_2samp
from pathlib import Path
from datetime import datetime

DATA_DIR = Path(__file__).resolve().parent.parent.parent / "data"

def load_json(path):
    with open(path, "r") as f:
        return json.load(f)

def detect_drift(model_id):
    ref_data = load_json(DATA_DIR / "reference_data.json")
    prod_data = load_json(DATA_DIR / "production_data.json")

    drift_scores = {}
    drift_features = []

    for feature in ref_data:
        ref_values = ref_data[feature]
        prod_values = prod_data.get(feature, [])

        if not prod_values or len(prod_values) < 10:
            continue

        stat, p_value = ks_2samp(ref_values, prod_values)
        drift_scores[feature] = round(stat, 3)
        if p_value < 0.05:
            drift_features.append(feature)

    return {
        "drift_detected": len(drift_features) > 0,
        "drift_features": drift_features,
        "drift_scores": drift_scores,
        "timestamp": datetime.utcnow().isoformat(),
    }

