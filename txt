import React, { useCallback, useEffect, useState } from 'react';
import ReactFlow, {
  MiniMap,
  Controls,
  Background,
  useNodesState,
  useEdgesState,
  addEdge,
} from 'reactflow';
import 'reactflow/dist/style.css';

const initialNodesData = [
  { id: 'start', label: 'Start', position: { x: 250, y: 0 } },
  { id: 'topicRequestA', label: 'Topic Request A', position: { x: 100, y: 100 } },
  { id: 'orchestrator', label: 'Orchestrator', position: { x: 250, y: 200 } },
  { id: 'topicRequestAgent', label: 'Topic Request Agent', position: { x: 400, y: 100 } },
  { id: 'mainAgent', label: 'Main Agent', position: { x: 600, y: 100 } },
  { id: 'topicResponseAgent', label: 'Topic Response Agent', position: { x: 400, y: 300 } },
  { id: 'topicResponseA', label: 'Topic Response A', position: { x: 100, y: 300 } },
];

const flowSequence = [
  ['start', 'topicRequestA'],
  ['topicRequestA', 'orchestrator'],
  ['start', 'orchestrator'],
  ['orchestrator', 'topicRequestAgent'],
  ['topicRequestAgent', 'mainAgent'],
  ['mainAgent', 'topicResponseAgent'],
  ['topicResponseAgent', 'orchestrator'],
  ['orchestrator', 'topicResponseA'],
];

const createNodeComponent = (node, status) => {
  const getBorderColor = () => {
    if (status === 'completed') return 'green';
    if (status === 'active') return 'blue';
    return 'grey';
  };

  const renderSquares = () => {
    const totalSquares = 5;
    return [...Array(totalSquares)].map((_, idx) => {
      let squareColor = '#ccc';
      if (status === 'active') squareColor = 'blue';
      if (status === 'completed') squareColor = 'green';
      return (
        <div
          key={idx}
          style={{
            width: 10,
            height: 10,
            backgroundColor: squareColor,
            margin: 2,
            borderRadius: 2,
            animation: status === 'active' ? 'pulse 1s infinite' : 'none',
          }}
        />
      );
    });
  };

  return {
    ...node,
    data: { label: node.label },
    style: {
      padding: 10,
      border: `3px solid ${getBorderColor()}`,
      borderRadius: 10,
      textAlign: 'center',
      background: '#fff',
    },
    draggable: false,
    sourcePosition: 'right',
    targetPosition: 'left',
    render: () => (
      <div style={{ padding: 10 }}>
        <div style={{ fontWeight: 'bold' }}>{node.label}</div>
        <div style={{ display: 'flex', justifyContent: 'center', marginTop: 5 }}>
          {renderSquares()}
        </div>
      </div>
    ),
  };
};

export default function OrchestratorFlow() {
  const [nodes, setNodes, onNodesChange] = useNodesState([]);
  const [edges, setEdges, onEdgesChange] = useEdgesState([]);
  const [activeIndex, setActiveIndex] = useState(0);
  const [nodeStatus, setNodeStatus] = useState({});

  const getEdgeColor = (source, target) => {
    const sourceCompleted = nodeStatus[source] === 'completed';
    const targetStatus = nodeStatus[target];
    if (targetStatus === 'active') return 'blue';
    if (sourceCompleted && targetStatus === 'completed') return 'green';
    return '#ccc';
  };

  const generateNodes = useCallback(() => {
    return initialNodesData.map((node) =>
      createNodeComponent(node, nodeStatus[node.id] || 'inactive')
    );
  }, [nodeStatus]);

  const generateEdges = useCallback(() => {
    return flowSequence.map(([source, target]) => ({
      id: `${source}-${target}`,
      source,
      target,
      animated: true,
      style: {
        stroke: getEdgeColor(source, target),
        strokeWidth: 2,
      },
    }));
  }, [nodeStatus]);

  useEffect(() => {
    setNodes(generateNodes());
    setEdges(generateEdges());
  }, [nodeStatus, generateNodes, generateEdges]);

  useEffect(() => {
    if (activeIndex >= flowSequence.length) return;

    const [source, target] = flowSequence[activeIndex];

    setNodeStatus((prev) => ({
      ...prev,
      [source]: 'completed',
      [target]: 'active',
    }));

    const timeout = setTimeout(() => {
      setNodeStatus((prev) => ({
        ...prev,
        [target]: 'completed',
      }));
      setActiveIndex((prev) => prev + 1);
    }, 1200);

    return () => clearTimeout(timeout);
  }, [activeIndex]);

  return (
    <div style={{ height: '90vh' }}>
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
      >
        <MiniMap />
        <Controls />
        <Background />
      </ReactFlow>

      {/* Add animation keyframes */}
      <style>{`
        @keyframes pulse {
          0% { transform: scale(1); opacity: 1; }
          50% { transform: scale(1.2); opacity: 0.6; }
          100% { transform: scale(1); opacity: 1; }
        }
      `}</style>
    </div>
  );
}
