import React, { useCallback } from 'react';
import ReactFlow, {
  MiniMap,
  Controls,
  Background,
  useNodesState,
  useEdgesState,
  addEdge,
} from 'react-flow-renderer';
import { Card, Tooltip } from 'antd';

const initialNodes = [
  { id: 'start', type: 'input', data: { label: 'Start' }, position: { x: 0, y: 200 } },
  { id: 'requestA', data: { label: 'Topic Request A' }, position: { x: 150, y: 100 } },
  { id: 'responseA', data: { label: 'Topic Response A' }, position: { x: 150, y: 300 } },
  { id: 'orchestrator', data: { label: 'Orchestrator' }, position: { x: 350, y: 200 }, style: { borderRadius: 50 } },
  { id: 'reqAgent', data: { label: 'Topic Request Agent' }, position: { x: 550, y: 100 } },
  { id: 'resAgent', data: { label: 'Topic Response Agent' }, position: { x: 550, y: 300 } },
  { id: 'mainAgent', data: { label: 'Main Agent' }, position: { x: 750, y: 200 } },
];

const initialEdges = [
  { id: 'e1', source: 'start', target: 'requestA', animated: true },
  { id: 'e2', source: 'start', target: 'responseA', animated: true },
  { id: 'e3', source: 'requestA', target: 'orchestrator' },
  { id: 'e4', source: 'responseA', target: 'start' },
  { id: 'e5', source: 'orchestrator', target: 'reqAgent' },
  { id: 'e6', source: 'reqAgent', target: 'mainAgent' },
  { id: 'e7', source: 'mainAgent', target: 'resAgent' },
  { id: 'e8', source: 'resAgent', target: 'orchestrator' },
  { id: 'e9', source: 'orchestrator', target: 'responseA' },
];

const OrchestratorStatusCard = () => {
  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes);
  const [edges, setEdges, onEdgesChange] = useEdgesState(initialEdges);

  const onConnect = useCallback(
    (params) => setEdges((eds) => addEdge({ ...params, animated: true }, eds)),
    [setEdges]
  );

  return (
    <Card
      title="Orchestrator Flow"
      bordered={false}
      style={{ height: '600px', width: '100%', backgroundColor: '#f7f9fc' }}
    >
      <Tooltip title="Interactive Agent Flow" placement="top">
        <div style={{ height: '500px' }}>
          <ReactFlow
            nodes={nodes}
            edges={edges}
            onNodesChange={onNodesChange}
            onEdgesChange={onEdgesChange}
            onConnect={onConnect}
            fitView
            attributionPosition="bottom-left"
          >
            <MiniMap />
            <Controls />
            <Background color="#aaa" gap={16} />
          </ReactFlow>
        </div>
      </Tooltip>
    </Card>
  );
};

export default OrchestratorStatusCard;
🧠 Notes:
Start → Topic Request A → Orchestrator → Topic Request Agent → Main Agent → Topic Response Agent → Orchestrator → Topic Response A → Start

Looks interactive, hoverable, and clean

Style can be expanded (e.g., colors for each node type, status indicators)

