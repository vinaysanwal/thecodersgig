import React, { useEffect, useState } from 'react';
import { Card, Col, Row, Typography, Table, Button, Select } from 'antd';
import axios from 'axios';
import { LineChart, Line, XAxis, YAxis, Tooltip, CartesianGrid, ResponsiveContainer } from 'recharts';

const { Title, Text } = Typography;
const { Option } = Select;

const Dashboard = () => {
  const [model, setModel] = useState('model_v3');
  const [data, setData] = useState(null);

  useEffect(() => {
    axios.get(`/api/orchestrate?model=${model}`).then(res => setData(res.data));
  }, [model]);

  const driftData = [
    {
      key: '1',
      feature: 'age',
      score: data?.drift?.score || 0.34,
      status: data?.drift?.drift_detected ? 'Drift' : 'Stable',
      date: 'Jun 25, 2025'
    }
  ];

  return (
    <div style={{ padding: 24 }}>
      <Title level={3}>ML Observatory</Title>

      <Row gutter={16} style={{ marginBottom: 24 }}>
        <Col span={6}><Card><Text>Model Health</Text><br /><b>{data?.status.includes('Healthy') ? 'Healthy ✅' : 'Degraded ⚠️'}</b></Card></Col>
        <Col span={6}><Card><Text>Drift Detected</Text><br /><b>{data?.drift?.drift_detected ? 'Yes' : 'No'}</b></Card></Col>
        <Col span={6}><Card><Text>Last Fix</Text><br /><b>2 hours ago</b></Card></Col>
      </Row>

      <Row gutter={16}>
        <Col span={16}>
          <Card title="Model Performance Over Time" style={{ marginBottom: 24 }}>
            <ResponsiveContainer width="100%" height={200}>
              <LineChart data={data?.performance?.trend || []}>
                <CartesianGrid strokeDasharray="3 3" />
                <XAxis dataKey="time" />
                <YAxis />
                <Tooltip />
                <Line type="monotone" dataKey="latency" stroke="#8884d8" />
                <Line type="monotone" dataKey="accuracy" stroke="#82ca9d" />
              </LineChart>
            </ResponsiveContainer>
          </Card>

          <Card title="Drift Detection">
            <Row gutter={16} style={{ marginBottom: 16 }}>
              <Col span={6}>
                <Select value={model} onChange={setModel} style={{ width: '100%' }}>
                  <Option value="model_v1">model_v1</Option>
                  <Option value="model_v2">model_v2</Option>
                  <Option value="model_v3">model_v3</Option>
                </Select>
              </Col>
              <Col span={6}><Select defaultValue="24h" style={{ width: '100%' }}><Option value="24h">Last 24 Hours</Option></Select></Col>
            </Row>

            <Table columns={[
              { title: 'Feature', dataIndex: 'feature' },
              { title: 'Drift Score', dataIndex: 'score' },
              { title: 'Status', dataIndex: 'status', render: s => s === 'Drift' ? <span style={{ color: 'red' }}>🔴 {s}</span> : s },
              { title: 'Detected On', dataIndex: 'date' },
              { title: 'Action', render: () => <Button type="link">Trigger Fix</Button> }
            ]} dataSource={driftData} pagination={false} />
          </Card>
        </Col>

        <Col span={8}>
          <Card title="Notifications">
            <ul>
              <li>⚠️ Drift detected in 'model_v3'</li>
              <li>✅ Patch applied for latency spike</li>
            </ul>
          </Card>
        </Col>
      </Row>
    </div>
  );
};

export default Dashboard;
