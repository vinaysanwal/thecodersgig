import datetime
from agents.drift_agent import get_drift_data

def detect_drift(model_id: str) -> dict:
    data = get_drift_data(model_id)
    return {
        "drift_detected": bool(data.get("drift_features")),
        "drift_features": data.get("drift_features", []),
        "drift_scores": data.get("drift_scores", {}),
        "timestamp": datetime.datetime.utcnow().isoformat()
    }


// backend/orchestrator/nodes/performance_node.py

from agents.performance_agent import get_performance_data

def evaluate_performance(model_id: str) -> dict:
    perf_data = get_performance_data(model_id)
    latest = perf_data.get("trend", [])[-1] if perf_data.get("trend") else {}
    latency = latest.get("latency", 0)
    accuracy = latest.get("accuracy", 1)

    return {
        "degraded": (latency > 500 or accuracy < 0.8),
        "latency": latency,
        "accuracy": accuracy
    }


