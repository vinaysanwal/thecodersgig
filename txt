html, body, #root {
  height: 100%;
  margin: 0;
}

.flow-wrapper {
  height: 100vh;
  width: 100%;
  background: radial-gradient(circle at center, #0a0f1c 0%, #05080f 80%);
  color: white;
}

/* TITLE */
.ease-title {
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 48px;
  color: #00f5ff;
  text-shadow: 0 0 20px #00f5ff;
  z-index: 10;
}

/* GLASS BOX */
.glass-node {
  background: rgba(10, 30, 60, 0.7);
  padding: 20px;
  border-radius: 12px;
  border: 1px solid #00f5ff;
  box-shadow: 0 0 20px rgba(0, 245, 255, 0.3);
  min-width: 220px;
}

/* CIRCLE NODE */
.circle-node {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  border: 2px solid #00f5ff;
  background: radial-gradient(circle, #001f2f, #000);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 30px #00f5ff;
}

.circle-content {
  text-align: center;
}

.circle-icon {
  font-size: 32px;
}

.circle-title {
  font-weight: bold;
  margin-top: 5px;
}

.circle-status {
  margin-top: 5px;
  font-size: 12px;
}

/* STATUS COLORS */
.circle-node.running {
  border-color: #00ff88;
  box-shadow: 0 0 30px #00ff88;
}

.circle-node.working {
  border-color: #ffc107;
  box-shadow: 0 0 30px #ffc107;
}

.circle-node.idle {
  border-color: #00f5ff;
}

.circle-node.failed {
  border-color: #ff4d4f;
  box-shadow: 0 0 30px #ff4d4f;
}
