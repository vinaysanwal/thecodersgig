import React, { useEffect, useRef, useState, useCallback } from 'react';
import ReactFlow, {
  MiniMap,
  Controls,
  Background,
  useNodesState,
  useEdgesState,
  Handle,
  Position,
} from 'reactflow';
import { Button, Card } from 'antd';
import 'reactflow/dist/style.css';
import './OrchestratorStyles.css';

const flowOrder = [
  'start',
  'topicRequestA',
  'orchestrator',
  'topicRequestAgent',
  'mainAgent',
  'topicResponseAgent',
  'orchestrator',
  'topicResponseA',
  'start',
];

// 🔹 Custom node component with animation
const AnimatedNode = ({ data, isActive }) => {
  return (
    <div className={`custom-node ${isActive ? 'active-node' : ''}`}>
      <Handle type="target" position={Position.Top} />
      <div className="node-label">{data.label}</div>
      <Handle type="source" position={Position.Bottom} />
    </div>
  );
};

const baseNodes = [
  { id: 'start', position: { x: 0, y: 100 }, data: { label: 'Start' }, type: 'animated' },
  { id: 'topicRequestA', position: { x: 200, y: 100 }, data: { label: 'Topic Request A' }, type: 'animated' },
  { id: 'orchestrator', position: { x: 400, y: 100 }, data: { label: 'Orchestrator' }, type: 'animated' },
  { id: 'topicRequestAgent', position: { x: 600, y: 100 }, data: { label: 'Topic Request Agent' }, type: 'animated' },
  { id: 'mainAgent', position: { x: 800, y: 100 }, data: { label: 'Main Agent' }, type: 'animated' },
  { id: 'topicResponseAgent', position: { x: 600, y: 250 }, data: { label: 'Topic Response Agent' }, type: 'animated' },
  { id: 'topicResponseA', position: { x: 200, y: 250 }, data: { label: 'Topic Response A' }, type: 'animated' },
];

const baseEdges = [
  { id: 'e1', source: 'start', target: 'topicRequestA' },
  { id: 'e2', source: 'topicRequestA', target: 'orchestrator' },
  { id: 'e3', source: 'orchestrator', target: 'topicRequestAgent' },
  { id: 'e4', source: 'topicRequestAgent', target: 'mainAgent' },
  { id: 'e5', source: 'mainAgent', target: 'topicResponseAgent' },
  { id: 'e6', source: 'topicResponseAgent', target: 'orchestrator' },
  { id: 'e7', source: 'orchestrator', target: 'topicResponseA' },
  { id: 'e8', source: 'topicResponseA', target: 'start' },
];

const OrchestratorStatusCard = () => {
  const [nodes, setNodes, onNodesChange] = useNodesState(baseNodes);
  const [edges, setEdges, onEdgesChange] = useEdgesState(baseEdges);
  const [activeStep, setActiveStep] = useState(-1);
  const intervalRef = useRef(null);

  const startFlow = () => {
    setActiveStep(0);
  };

  const updateNodeStyles = useCallback(
    (currentId) => {
      setNodes((nds) =>
        nds.map((node) => ({
          ...node,
          data: {
            ...node.data,
            isActive: node.id === currentId,
          },
        }))
      );
    },
    [setNodes]
  );

  useEffect(() => {
    if (activeStep >= 0 && activeStep < flowOrder.length) {
      const currentNodeId = flowOrder[activeStep];
      updateNodeStyles(currentNodeId);
      intervalRef.current = setTimeout(() => {
        setActiveStep((prev) => prev + 1);
      }, 3000);
    }

    return () => clearTimeout(intervalRef.current);
  }, [activeStep, updateNodeStyles]);

  return (
    <Card
      title="Orchestrator Animated Flow"
      extra={<Button type="primary" onClick={startFlow}>Start</Button>}
      style={{ height: '600px' }}
    >
      <ReactFlow
        nodes={nodes}
        edges={edges}
        nodeTypes={{ animated: AnimatedNode }}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
      >
        <MiniMap />
        <Controls />
        <Background variant="dots" gap={12} size={1} />
      </ReactFlow>
    </Card>
  );
};

export default OrchestratorStatusCard;
