Problem Statement
Design a data structure that supports the following operations in O(1) time:

get(key) – return the value if the key exists, else return -1

put(key, value) – insert/update the key. If capacity exceeded, evict the least recently used item

🧠 Approach
Use:

A Map to store key-node pairs (fast lookup)

A doubly linked list to track LRU order (fast eviction/move to front)

The most recently used (MRU) node is at the head,
The least recently used (LRU) is at the tail.

🧪 JavaScript Code – LRU Cache
js
Copy
Edit
class Node {
  constructor(key, val) {
    this.key = key;
    this.val = val;
    this.prev = null;
    this.next = null;
  }
}

class LRUCache {
  constructor(capacity) {
    this.capacity = capacity;
    this.map = new Map(); // key → node
    this.head = new Node(); // dummy head
    this.tail = new Node(); // dummy tail
    this.head.next = this.tail;
    this.tail.prev = this.head;
  }

  _remove(node) {
    node.prev.next = node.next;
    node.next.prev = node.prev;
  }

  _add(node) {
    // Always add right after head (MRU position)
    node.next = this.head.next;
    node.prev = this.head;
    this.head.next.prev = node;
    this.head.next = node;
  }

  get(key) {
    if (!this.map.has(key)) return -1;
    const node = this.map.get(key);
    this._remove(node);
    this._add(node);
    return node.val;
  }

  put(key, value) {
    if (this.map.has(key)) {
      // Remove old node
      this._remove(this.map.get(key));
    }

    const newNode = new Node(key, value);
    this._add(newNode);
    this.map.set(key, newNode);

    if (this.map.size > this.capacity) {
      // Remove LRU node (before tail)
      const lru = this.tail.prev;
      this._remove(lru);
      this.map.delete(lru.key);
    }
  }
}
📌 Example Usage
js
Copy
Edit
const lru = new LRUCache(2);

lru.put(1, 1);
lru.put(2, 2);
console.log(lru.get(1)); // 1

lru.put(3, 3); // Evicts key 2
console.log(lru.get(2)); // -1

lru.put(4, 4); // Evicts key 1
console.log(lru.get(1)); // -1
console.log(lru.get(3)); // 3
console.log(lru.get(4)); // 4
🔍 Time & Space Complexity
Operation	Time	Space
get	O(1)	O(n)
put	O(1)	O(n)

