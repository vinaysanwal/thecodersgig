from scipy.stats import ks_2samp
import pandas as pd

def run(reference_path: str, live_path: str) -> dict:
    ref = pd.read_csv(reference_path)
    live = pd.read_csv(live_path)
    drifted_features = []
    drift_scores = {}

    for col in ref.columns:
        if col in live.columns:
            stat, p = ks_2samp(ref[col], live[col])
            drift_scores[col] = float(stat)
            if p < 0.05:
                drifted_features.append(col)

    return {
        "drift_detected": bool(drifted_features),
        "drift_features": drifted_features,
        "drift_scores": drift_scores
    }


# agents/performance_agent.py
import pandas as pd

def run(predictions_path: str) -> dict:
    df = pd.read_csv(predictions_path)
    correct = (df['true_label'] == df['predicted_label']).sum()
    total = len(df)
    accuracy = correct / total if total else 0
    avg_latency = df['latency_ms'].mean()

    return {
        "accuracy": accuracy,
        "avg_latency": avg_latency,
        "performance_issues": accuracy < 0.85 or avg_latency > 300
    }


# agents/remediation_agent.py
from langchain.chat_models import AzureChatOpenAI
from langchain.prompts import PromptTemplate

llm = AzureChatOpenAI(deployment_name="your-azure-deployment", temperature=0)

def run(state: dict) -> str:
    drift = state.get("drift_features", [])
    perf_issues = state.get("performance_issues", False)
    accuracy = state.get("accuracy")
    latency = state.get("avg_latency")

    prompt = PromptTemplate.from_template("""
    You are an ML reliability assistant.
    Based on the following inputs, suggest a clear and concise remediation plan.

    Drift Features: {drift}
    Accuracy: {accuracy}
    Latency: {latency}
    Performance Issues: {perf_issues}
    """)

    message = prompt.format(drift=drift, accuracy=accuracy, latency=latency, perf_issues=perf_issues)
    return llm.predict(message)
