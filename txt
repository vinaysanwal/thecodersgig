from agents.remediation_agent import get_remediation_logs

def suggest_remediation(state: dict) -> dict:
    logs = get_remediation_logs()
    return {
        "action": "Triggered auto-retraining",
        "timestamp": logs[0]["timestamp"] if logs else "N/A",
        "details": logs[0]["message"] if logs else "Simulated remediation log"
    }
