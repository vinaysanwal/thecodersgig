body {
  margin: 0;
  background: radial-gradient(circle at center, #0a0a0a 0%, #000 80%);
  font-family: "Segoe UI", sans-serif;
  color: white;
}

.ease-container {
  padding: 50px;
}

.title {
  text-align: center;
  font-size: 48px;
  color: #E30613;
  letter-spacing: 6px;
}

.layout {
  display: grid;
  grid-template-columns: 250px 1fr 250px;
  gap: 40px;
  margin-top: 40px;
}

/* INPUTS */
.input-card {
  background: #111;
  padding: 15px;
  margin: 15px 0;
  border: 1px solid #333;
  cursor: pointer;
  transition: 0.3s;
}

.input-card:hover {
  border-color: #E30613;
  box-shadow: 0 0 15px #E30613;
}

/* CORE */
.core {
  position: relative;
  text-align: center;
}

.ease-circle {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  border: 3px solid #E30613;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: auto;
  font-size: 20px;
  box-shadow: 0 0 30px #E30613;
}

.box {
  background: #111;
  margin: 12px auto;
  padding: 10px;
  width: 60%;
}

.small {
  font-size: 12px;
}

.mcp-box {
  border: 1px solid #E30613;
}

.db {
  margin-top: 15px;
  padding: 10px;
  border: 1px solid #444;
  border-radius: 20px;
}

.svg-layer {
  position: absolute;
  width: 100%;
  height: 300px;
  top: 0;
  left: 0;
  pointer-events: none;
}

/* AGENTS */
.agent-ring {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  border: 2px solid #E30613;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 25px;
  text-align: center;
  box-shadow: 0 0 20px #E30613;
}

.agent-ring.idle {
  border-color: gray;
  box-shadow: none;
}

.agent-ring.working {
  border-color: orange;
  box-shadow: 0 0 20px orange;
}

.agent-ring.failed {
  border-color: red;
  box-shadow: 0 0 20px red;
}

/* METRICS */
.metrics {
  display: flex;
  gap: 20px;
  margin-top: 60px;
}

.metric-card {
  background: #111;
  padding: 20px;
  border: 1px solid #E30613;
  flex: 1;
}
