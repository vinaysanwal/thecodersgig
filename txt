import React, { useEffect, useState } from 'react';
import ReactFlow, {
  useNodesState,
  useEdgesState,
  Background,
  Controls,
  MiniMap,
} from 'reactflow';
import 'reactflow/dist/style.css';
import './orchestratorStyles.css';

const sequence = [
  'Start',
  'Topic Request A',
  'Orchestrator',
  'Topic Request Agent',
  'Main Agent',
  'Topic Response Agent',
  'Orchestrator',
  'Topic Response A',
  'Start',
];

const initialNodes = sequence.map((id, index) => {
  const position = [
    { x: 50, y: 300 },
    { x: 250, y: 100 },
    { x: 500, y: 300 },
    { x: 750, y: 100 },
    { x: 1000, y: 300 },
    { x: 750, y: 500 },
    { x: 250, y: 500 },
  ];

  return {
    id,
    data: { label: id },
    position: position[index % position.length],
    style: {
      border: '2px solid #aaa',
      padding: 10,
      borderRadius: 8,
      backgroundColor: '#fff',
    },
  };
});

const initialEdges = [
  { id: 'e1', source: 'Start', target: 'Topic Request A' },
  { id: 'e2', source: 'Topic Request A', target: 'Orchestrator' },
  { id: 'e3', source: 'Orchestrator', target: 'Topic Request Agent' },
  { id: 'e4', source: 'Topic Request Agent', target: 'Main Agent' },
  { id: 'e5', source: 'Main Agent', target: 'Topic Response Agent' },
  { id: 'e6', source: 'Topic Response Agent', target: 'Orchestrator' },
  { id: 'e7', source: 'Orchestrator', target: 'Topic Response A' },
  { id: 'e8', source: 'Topic Response A', target: 'Start' },
];

export default function OrchestratorStatusCard() {
  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes);
  const [edges, setEdges, onEdgesChange] = useEdgesState(initialEdges);
  const [activeIndex, setActiveIndex] = useState(-1);

  // Glow box nodes
  const glowBoxNodes = ['Topic Request A', 'Topic Response A', 'Topic Request Agent', 'Topic Response Agent'];

  useEffect(() => {
    if (activeIndex === -1 || activeIndex >= sequence.length) return;

    const currentNodeId = sequence[activeIndex];
    const updatedNodes = nodes.map((node) => {
      if (node.id === currentNodeId) {
        return {
          ...node,
          style: { ...node.style, backgroundColor: '#e0ffe0', borderColor: 'green' },
          data: {
            ...node.data,
            label: (
              <div>
                {node.id}
                {glowBoxNodes.includes(node.id) && (
                  <div className="glow-boxes">
                    {[0, 1, 2, 3].map((i) => (
                      <div key={i} className="glow-box green" />
                    ))}
                  </div>
                )}
              </div>
            ),
          },
        };
      } else if (sequence.indexOf(node.id) < activeIndex) {
        return {
          ...node,
          style: { ...node.style, backgroundColor: '#ffe0e0', borderColor: 'red' },
        };
      } else {
        return {
          ...node,
          style: { ...node.style, backgroundColor: '#fff', borderColor: '#aaa' },
          data: {
            ...node.data,
            label: (
              <div>
                {node.id}
                {glowBoxNodes.includes(node.id) && (
                  <div className="glow-boxes">
                    {[0, 1, 2, 3].map((i) => (
                      <div key={i} className="glow-box grey" />
                    ))}
                  </div>
                )}
              </div>
            ),
          },
        };
      }
    });

    const updatedEdges = initialEdges.map((edge) => {
      const fromIdx = sequence.indexOf(edge.source);
      const toIdx = sequence.indexOf(edge.target);
      if (fromIdx === activeIndex && toIdx === activeIndex + 1) {
        return { ...edge, style: { stroke: 'green', strokeWidth: 3 }, animated: true };
      } else if (toIdx <= activeIndex) {
        return { ...edge, style: { stroke: 'red', strokeWidth: 2 } };
      } else {
        return { ...edge, style: { stroke: '#bbb' } };
      }
    });

    setNodes(updatedNodes);
    setEdges(updatedEdges);

    const timer = setTimeout(() => {
      setActiveIndex((prev) => prev + 1);
    }, 3000);

    return () => clearTimeout(timer);
  }, [activeIndex]);

  const onStart = () => {
    setActiveIndex(0);
  };

  return (
    <div style={{ height: '90vh', background: '#f2f5f9', borderRadius: 10 }}>
      <button onClick={onStart} style={{ margin: 10, padding: '6px 12px' }}>
        Start Animation
      </button>
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
      >
        <MiniMap />
        <Controls />
        <Background variant="dots" gap={16} size={1} />
      </ReactFlow>
    </div>
  );
}


.glow-boxes {
  display: flex;
  justify-content: center;
  margin-top: 6px;
  gap: 4px;
}

.glow-box {
  width: 10px;
  height: 10px;
  border-radius: 2px;
  transition: background-color 0.3s ease-in-out;
}

.glow-box.green {
  background-color: #00cc44;
  box-shadow: 0 0 4px #00cc44;
}

.glow-box.red {
  background-color: #cc0000;
  box-shadow: 0 0 4px #cc0000;
}

.glow-box.grey {
  background-color: #ccc;
}
