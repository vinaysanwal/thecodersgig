import React, { useCallback, useEffect, useState } from 'react';
import ReactFlow, {
  MiniMap,
  Controls,
  Background,
  useNodesState,
  useEdgesState,
  addEdge,
} from 'reactflow';
import 'reactflow/dist/style.css';
import './orchestratorStyles.css'; // Make sure to include this CSS (see below)

const initialNodes = [
  { id: 'Start', data: { label: 'Start' }, position: { x: 50, y: 300 } },
  { id: 'Topic Request A', data: { label: 'Topic Request A' }, position: { x: 250, y: 100 } },
  { id: 'Orchestrator', data: { label: 'Orchestrator' }, position: { x: 500, y: 300 } },
  { id: 'Topic Request Agent', data: { label: 'Topic Request Agent' }, position: { x: 750, y: 100 } },
  { id: 'Main Agent', data: { label: 'Main Agent' }, position: { x: 1000, y: 300 } },
  { id: 'Topic Response Agent', data: { label: 'Topic Response Agent' }, position: { x: 750, y: 500 } },
  { id: 'Topic Response A', data: { label: 'Topic Response A' }, position: { x: 250, y: 500 } },
];

const initialEdges = [
  { id: 'e1', source: 'Start', target: 'Topic Request A' },
  { id: 'e2', source: 'Topic Request A', target: 'Orchestrator' },
  { id: 'e3', source: 'Orchestrator', target: 'Topic Request Agent' },
  { id: 'e4', source: 'Topic Request Agent', target: 'Main Agent' },
  { id: 'e5', source: 'Main Agent', target: 'Topic Response Agent' },
  { id: 'e6', source: 'Topic Response Agent', target: 'Orchestrator' },
  { id: 'e7', source: 'Orchestrator', target: 'Topic Response A' },
  { id: 'e8', source: 'Topic Response A', target: 'Start' },
];

const glowBoxes = (isActive, isCompleted) => {
  const colors = isActive
    ? ['green', 'red', 'green', 'red']
    : isCompleted
    ? ['#cc0000', '#cc0000', '#cc0000', '#cc0000']
    : ['#ccc', '#ccc', '#ccc', '#ccc'];

  return (
    <div className="glow-boxes">
      {colors.map((color, index) => (
        <div
          key={index}
          className="glow-box"
          style={{ backgroundColor: color }}
        ></div>
      ))}
    </div>
  );
};

const CustomNode = ({ data, id }) => {
  const [isActive, setIsActive] = useState(false);
  const [isCompleted, setIsCompleted] = useState(false);

  useEffect(() => {
    const unsub = window.subscribeNodeStatus?.(id, ({ active, completed }) => {
      setIsActive(active);
      setIsCompleted(completed);
    });
    return () => unsub?.();
  }, [id]);

  const shouldRenderGlow =
    id === 'Topic Request A' ||
    id === 'Topic Response A' ||
    id === 'Topic Request Agent' ||
    id === 'Topic Response Agent';

  return (
    <div className={`node-box ${isActive ? 'active' : ''} ${isCompleted ? 'completed' : ''}`}>
      <div>{data.label}</div>
      {shouldRenderGlow && glowBoxes(isActive, isCompleted)}
    </div>
  );
};

const nodeTypes = {
  default: CustomNode,
};

export default function OrchestratorStatusCard() {
  const [nodes, setNodes, onNodesChange] = useNodesState(
    initialNodes.map((node) => ({
      ...node,
      type: 'default',
    }))
  );
  const [edges, setEdges, onEdgesChange] = useEdgesState(initialEdges);

  const [activeIndex, setActiveIndex] = useState(-1);

  const sequence = [
    'Start',
    'Topic Request A',
    'Orchestrator',
    'Topic Request Agent',
    'Main Agent',
    'Topic Response Agent',
    'Orchestrator',
    'Topic Response A',
    'Start',
  ];

  // Broadcast status to each CustomNode using global event pub/sub
  useEffect(() => {
    window.subscribeNodeStatus = (id, callback) => {
      const handler = ({ node, activeIndex }) => {
        const current = sequence[activeIndex];
        const completed = sequence.slice(0, activeIndex);
        callback({
          active: node === id,
          completed: completed.includes(id),
        });
      };
      window.addEventListener('node-status', handler);
      return () => window.removeEventListener('node-status', handler);
    };
  }, []);

  useEffect(() => {
    let timer;

    if (activeIndex >= 0 && activeIndex < sequence.length) {
      const event = new CustomEvent('node-status', {
        detail: { node: sequence[activeIndex], activeIndex },
      });
      window.dispatchEvent(event);

      timer = setTimeout(() => {
        setActiveIndex((prev) => prev + 1);
      }, 3000);
    }
  }, [activeIndex]);

  const onStart = () => {
    setActiveIndex(0);
  };

  return (
    <div style={{ height: '90vh', background: '#f2f5f9', borderRadius: 10 }}>
      <button onClick={onStart} style={{ margin: 10, padding: '6px 12px' }}>
        Start Animation
      </button>
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
        nodeTypes={nodeTypes}
      >
        <MiniMap />
        <Controls />
        <Background variant="dots" gap={16} size={1} />
      </ReactFlow>
    </div>
  );
}
