from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
import pandas as pd
from agents.drift_agent import run as run_drift_agent
from agents.performance_agent import run as run_performance_agent
from agents.remediation_agent import run as run_remediation_agent
from orchestrator.langgraph_orchestrator import run_orchestrator

app = FastAPI()

# Enable CORS for frontend
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.get("/api/performance")
def get_performance_data():
    result = run_performance_agent("data/predictions.csv")
    df = pd.read_csv("data/predictions.csv")
    grouped = df.groupby(pd.cut(df.index, 10))
    trend_data = [
        {
            "time": f"t{i+1}",
            "accuracy": round((g['true_label'] == g['predicted_label']).mean(), 2),
            "latency": int(g["latency_ms"].mean())
        }
        for i, g in enumerate(grouped)
    ]
    result["trend"] = trend_data
    return result

@app.get("/api/notifications")
def get_notifications():
    return [
        "Latency spiked above 350ms at 10:45am",
        "Model accuracy dropped below threshold at 11:00am",
        "Feature 'age' drift score exceeded limit"
    ]

@app.get("/api/drift")
def get_drift_data():
    result = run_drift_agent("data/reference.csv", "data/live.csv")
    return result

@app.get("/api/remediation")
def get_remediation():
    drift_result = run_drift_agent("data/reference.csv", "data/live.csv")
    perf_result = run_performance_agent("data/predictions.csv")
    combined_state = {**drift_result, **perf_result}
    plan = run_remediation_agent(combined_state)
    return {"remediation_plan": plan}

@app.get("/run-orchestrator")
def run_full_orchestration():
    result = run_orchestrator({
        "reference_data": "data/reference.csv",
        "live_data": "data/live.csv",
        "predictions_data": "data/predictions.csv"
    })
    return result
