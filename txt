/* ============================= */
/* OBSERVABILITY PAGE LAYOUT */
/* ============================= */

.obs-wrapper {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  background: radial-gradient(circle at center, #0f2027, #090a0f);
  color: white;
}

/* Header */
.obs-header {
  height: 70px;
  display: flex;
  align-items: center;
  padding-left: 30px;
  font-size: 28px;
  font-weight: 600;
  letter-spacing: 1px;
  border-bottom: 1px solid rgba(0, 255, 255, 0.2);
  text-shadow: 0 0 12px #00ffff;
}

/* Body layout */
.obs-body {
  flex: 1;
  display: flex;
}

/* Sidebar */
.obs-sidebar {
  width: 220px;
  border-right: 1px solid rgba(0, 255, 255, 0.2);
  padding-top: 30px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Sidebar Items */
.sidebar-item {
  padding: 12px 20px;
  cursor: pointer;
  transition: all 0.3s ease;
  border-left: 3px solid transparent;
  font-size: 15px;
  letter-spacing: 0.5px;
}

.sidebar-item:hover {
  background: rgba(0, 255, 255, 0.08);
  border-left: 3px solid #00ffff;
}

.sidebar-item.active {
  background: rgba(0, 255, 255, 0.15);
  border-left: 3px solid #00ffff;
  box-shadow: inset 0 0 15px rgba(0, 255, 255, 0.2);
}

/* Main content area */
.obs-content {
  flex: 1;
  position: relative;
}

/* Fix inner flow height */
.obs-content .cyber-wrapper {
  height: calc(100vh - 70px);
}
