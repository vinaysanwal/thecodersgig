import React, { useCallback, useEffect, useRef, useState } from 'react';
import ReactFlow, {
  MiniMap,
  Controls,
  Background,
  useNodesState,
  useEdgesState,
  addEdge,
} from 'reactflow';
import 'reactflow/dist/style.css';
import { Card, Button } from 'antd';

// Nodes configuration
const initialNodes = [
  { id: 'Start', position: { x: 0, y: 0 }, data: { label: 'Start' }, style: {} },
  { id: 'TopicRequestA', position: { x: 200, y: 0 }, data: { label: 'Topic Request A' }, style: {} },
  { id: 'Orchestrator', position: { x: 400, y: 0 }, data: { label: 'Orchestrator' }, style: {} },
  { id: 'TopicRequestAgent', position: { x: 600, y: 0 }, data: { label: 'Topic Request Agent' }, style: {} },
  { id: 'MainAgent', position: { x: 800, y: 0 }, data: { label: 'Main Agent' }, style: {} },
  { id: 'TopicResponseAgent', position: { x: 600, y: 150 }, data: { label: 'Topic Response Agent' }, style: {} },
  { id: 'TopicResponseA', position: { x: 200, y: 150 }, data: { label: 'Topic Response A' }, style: {} },
];

const connectionFlow = [
  ['Start', 'TopicRequestA'],
  ['TopicRequestA', 'Orchestrator'],
  ['Orchestrator', 'TopicRequestAgent'],
  ['TopicRequestAgent', 'MainAgent'],
  ['MainAgent', 'TopicResponseAgent'],
  ['TopicResponseAgent', 'Orchestrator'],
  ['Orchestrator', 'TopicResponseA'],
  ['TopicResponseA', 'Start'],
];

const nodeColor = (status) => {
  if (status === 'active') return '#52c41a'; // Green
  if (status === 'completed') return '#f5222d'; // Red
  return '#d9d9d9'; // Grey
};

const OrchestratorStatusCard = () => {
  const [nodes, setNodes, onNodesChange] = useNodesState([]);
  const [edges, setEdges, onEdgesChange] = useEdgesState([]);
  const [activeStep, setActiveStep] = useState(0);
  const [started, setStarted] = useState(false);
  const timerRef = useRef(null);

  // Add node lights
  const decorateNode = useCallback((id, status) => {
    return {
      id,
      style: {
        border: '2px solid black',
        borderRadius: '8px',
        padding: 10,
        backgroundColor: '#fff',
      },
      data: {
        label: (
          <div style={{ position: 'relative', padding: '4px' }}>
            <div>{id}</div>
            <div
              style={{
                width: 12,
                height: 12,
                backgroundColor: nodeColor(status),
                borderRadius: '50%',
                position: 'absolute',
                top: 0,
                right: 0,
              }}
            />
          </div>
        ),
      },
    };
  }, []);

  const resetFlow = useCallback(() => {
    const resetNodes = initialNodes.map((node) => decorateNode(node.id, ''));
    setNodes(resetNodes);
    setEdges([]);
    setActiveStep(0);
    setStarted(false);
  }, [decorateNode]);

  const startFlow = () => {
    if (started) return;
    setStarted(true);
    resetFlow();

    timerRef.current = setInterval(() => {
      setActiveStep((step) => {
        if (step >= connectionFlow.length) {
          clearInterval(timerRef.current);
          return step;
        }

        const [source, target] = connectionFlow[step];

        // Add edge
        setEdges((prev) => [
          ...prev,
          {
            id: `${source}->${target}`,
            source,
            target,
            animated: false,
            style: { stroke: '#f5222d', strokeWidth: 2 },
          },
        ]);

        // Update node statuses
        setNodes((nds) =>
          nds.map((node) => {
            if (node.id === source) return decorateNode(source, 'completed');
            if (node.id === target) return decorateNode(target, 'active');
            return node;
          })
        );

        return step + 1;
      });
    }, 3000);
  };

  useEffect(() => {
    resetFlow();
  }, [resetFlow]);

  return (
    <Card title="Orchestrator Flow Status" style={{ height: '700px' }} extra={<Button onClick={startFlow}>Start</Button>}>
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        fitView
      >
        <Background variant="lines" gap={20} />
        <MiniMap />
        <Controls />
      </ReactFlow>
    </Card>
  );
};

export default OrchestratorStatusCard;
