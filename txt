const { Title } = Typography;

const OrchestratorStatusCard = () => {
  return (
    <Card title="OrchestratorStatusCard" bordered={true} className="orchestrator-card">
      <div className="flow-container">
        {/* Top Flow */}
        <div className="top-row">
          <div className="box">Start</div>
          <div className="arrow">→</div>
          <div className="box">Topic Request A</div>
          <div className="arrow">→</div>
          <div className="box">Orchestrator</div>
          <div className="arrow">→</div>
          <div className="box">Topic Request Agent</div>
          <div className="arrow">→</div>
          <div className="circle-box">Main Agent</div>
        </div>

        {/* Curved Flow (down to response agent) */}
        <div className="curved-connector">
          ⟳
        </div>

        {/* Bottom Flow */}
        <div className="bottom-row">
          <div className="circle-box">Topic Response Agent</div>
