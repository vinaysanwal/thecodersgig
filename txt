body {
  margin: 0;
  background: #000000;
  font-family: "Inter", sans-serif;
  color: #ffffff;
}

.home-container {
  min-height: 100vh;
  padding: 30px;
}

.title {
  text-align: center;
  color: #e0001b;
  letter-spacing: 6px;
  margin-bottom: 20px;
}

.flow-section {
  height: 60vh;
  border: 1px solid #222;
  border-radius: 12px;
  background: #0b0b0b;
  overflow: hidden;
}

/* -------- AGENT SECTION -------- */

.agent-section {
  margin-top: 50px;
}

.section-title {
  text-align: center;
  color: #e0001b;
  letter-spacing: 3px;
  margin-bottom: 25px;
}

.agent-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}

.agent-card {
  background: #0b0b0b;
  border: 1px solid #e0001b;
  border-radius: 12px;
  padding: 20px;
  transition: 0.3s ease;
}

.agent-card:hover {
  border-color: #00a651;
}

.agent-card h3 {
  color: #e0001b;
  margin-top: 0;
}

.agent-card ul {
  padding-left: 20px;
}

/* -------- METRICS -------- */

.metrics-section {
  margin-top: 50px;
  display: flex;
  justify-content: space-between;
  gap: 20px;
}

.metric-box {
  flex: 1;
  background: #0b0b0b;
  border: 1px solid #ffffff;
  padding: 20px;
  border-radius: 10px;
  text-align: center;
}

.metric-number {
  font-size: 24px;
  font-weight: 600;
}

.green {
  color: #00a651;
}

.red {
  color: #e0001b;
}

.kafka-dot {
  pointer-events: none;
}
