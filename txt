# orchestrator/langgraph_orchestrator.py

from langgraph.graph import StateGraph, END
from orchestrator.nodes.drift_node import drift_node
from orchestrator.nodes.performance_node import performance_node
from orchestrator.nodes.remediation_node import remediation_node
from orchestrator.nodes.decision_node import decision_node

# Shared state structure
class AgentState(dict):
    # Acts as a mutable key-value store for agent communication
    pass

def build_graph():
    graph = StateGraph(AgentState)

    # Define agent nodes
    graph.add_node("drift", drift_node)
    graph.add_node("performance", performance_node)
    graph.add_node("remediation", remediation_node)
    graph.add_node("decision", decision_node)

    # Set entry point
    graph.set_entry_point("decision")

    # Conditional routing from decision
    graph.add_conditional_edges(
        "decision",
        decision_node,
        {
            "drift": "drift",
            "performance": "performance",
            "remediation": "remediation",
            "end": END,
        }
    )

    # Loop back to decision after each agent step
    graph.add_edge("drift", "decision")
    graph.add_edge("performance", "decision")
    graph.add_edge("remediation", "decision")

    return graph.compile()

def run_orchestrator(initial_state):
    graph = build_graph()
    result = graph.invoke(initial_state)
    return result
