.orchestrator-card {
  width: 100%;
  max-width: 1200px;
  margin: auto;
  background: #f9f9f9;
}

.flow-container {
  position: relative;
  padding: 20px;
  min-height: 250px;
}

.row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 80px;
}

.node {
  padding: 10px 16px;
  background: #ffffff;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-weight: 500;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  min-width: 120px;
  text-align: center;
}

.node.active {
  background-color: #bae7ff;
  border-color: #1890ff;
  box-shadow: 0 0 10px #1890ff;
}

.arrow-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 250px;
  pointer-events: none;
}

.arrow {
  stroke: #1890ff;
  stroke-width: 2;
  marker-end: url(#arrow);
}
