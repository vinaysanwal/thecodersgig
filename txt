import React, { useEffect, useRef } from "react";
import "./home.css";
import { gsap } from "gsap";
import { MotionPathPlugin } from "gsap/MotionPathPlugin";

gsap.registerPlugin(MotionPathPlugin);

export default function Home() {
  const pulseRef = useRef(null);

  useEffect(() => {
    // Continuous subtle streaming on all paths
    gsap.to(".stream", {
      strokeDashoffset: -2000,
      duration: 25,
      repeat: -1,
      ease: "linear"
    });

    // MCP breathing glow
    gsap.to(".mcp", {
      boxShadow: "0 0 40px #E30613",
      duration: 2,
      repeat: -1,
      yoyo: true
    });

  }, []);

  const triggerFlow = () => {
    const pulse = pulseRef.current;

    gsap.set(pulse, { opacity: 1 });

    gsap.to(pulse, {
      duration: 2,
      motionPath: {
        path: "#routeMain",
        align: "#routeMain",
        autoRotate: false
      },
      ease: "power2.inOut",
      onComplete: () => gsap.set(pulse, { opacity: 0 })
    });

    gsap.fromTo(
      ".agent-ring",
      { boxShadow: "0 0 15px #E30613" },
      {
        boxShadow: "0 0 60px #E30613",
        duration: 0.8,
        yoyo: true,
        repeat: 1
      }
    );
  };

  return (
    <div className="page">

      <div className="ambient-glow"></div>

      <h1 className="title">EASE</h1>

      <div className="main-container">

        {/* LEFT INPUTS */}
        <div className="panel inputs">
          <h3>INPUTS</h3>
          <div className="input-btn" onClick={triggerFlow}>
            Human (Click to Trigger)
          </div>
          <div className="input-btn">API</div>
          <div className="input-btn">Agents</div>
        </div>

        {/* CENTER CORE */}
        <div className="core">

          <div className="ease-core">
            EASE
          </div>

          <div className="box">Orchestrator</div>
          <div className="box">Agent Registry</div>
          <div className="box small">
            Observability — Logs • Traces • Monitoring
          </div>

          <div className="box mcp">MCP</div>

          <div className="db-pedestal">DB</div>

          <svg className="routes">
            <path
              id="routeMain"
              className="stream"
              d="M 200 150 C 400 50 700 250 900 150"
              stroke="#E30613"
              strokeWidth="2"
              fill="none"
              strokeDasharray="15 15"
            />
          </svg>

          <div ref={pulseRef} className="pulse"></div>

        </div>

        {/* RIGHT AGENTS */}
        <div className="panel agents">
          <div className="agent-ring running">
            PAT Agent
            <span>RUNNING</span>
          </div>

          <div className="agent-ring idle">
            Compliance
            <span>IDLE</span>
          </div>

          <div className="agent-ring working">
            Risk Analyst
            <span>WORKING</span>
          </div>

          <div className="agent-ring failed">
            Report Gen
            <span>FAILED</span>
          </div>
        </div>

      </div>

      {/* METRICS SECTION */}
      <div className="metrics-container">

        <div className="metrics-grid">

          <div className="metric-card">
            <h4>Evaluations Agent</h4>
            <ul>
              <li>Risk assessments</li>
              <li>Pattern analysis</li>
              <li>Event scoring</li>
            </ul>
          </div>

          <div className="metric-card">
            <h4>Risk Analyst Agent</h4>
            <ul>
              <li>Suspicious detection</li>
              <li>Escalation logic</li>
              <li>Market insights</li>
            </ul>
          </div>

          <div className="metric-card">
            <h4>PAT Agent</h4>
            <ul>
              <li>Compliance scoring</li>
              <li>Monitoring rules</li>
              <li>Alert triggers</li>
            </ul>
          </div>

        </div>

        <div className="summary">
          <h4>METRICS</h4>
          <p>Active Agents: 4</p>
          <p>Total Sessions: 128</p>

          <div className="why">
            <h4>WHY EASE?</h4>
            <ul>
              <li>Built on Kafka</li>
              <li>Integrates with existing systems</li>
              <li>Scalable & reliable</li>
              <li>Self-learning</li>
            </ul>
          </div>
        </div>

      </div>

    </div>
  );
}
