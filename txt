body {
  margin: 0;
  background: radial-gradient(circle at center, #0b0b0b 0%, #000 80%);
  font-family: "Segoe UI", sans-serif;
  color: white;
}

.page {
  padding: 40px;
  position: relative;
}

.ambient-glow {
  position: absolute;
  top: 100px;
  left: 50%;
  width: 600px;
  height: 600px;
  transform: translateX(-50%);
  background: radial-gradient(circle, rgba(227,6,19,0.2), transparent 70%);
  z-index: 0;
}

.title {
  text-align: center;
  font-size: 52px;
  color: #E30613;
  letter-spacing: 6px;
  margin-bottom: 40px;
}

.main-container {
  display: grid;
  grid-template-columns: 250px 1fr 250px;
  gap: 40px;
  align-items: center;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.input-btn {
  background: #111;
  border: 1px solid #333;
  padding: 14px;
  cursor: pointer;
  transition: 0.3s;
}

.input-btn:hover {
  border-color: #E30613;
  box-shadow: 0 0 20px #E30613;
}

.core {
  text-align: center;
  position: relative;
}

.ease-core {
  width: 140px;
  height: 140px;
  border-radius: 50%;
  border: 3px solid #E30613;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: auto;
  font-size: 22px;
  box-shadow: 0 0 40px #E30613;
}

.box {
  margin: 14px auto;
  background: #111;
  padding: 12px;
  width: 60%;
}

.small {
  font-size: 13px;
}

.mcp {
  border: 1px solid #E30613;
}

.db-pedestal {
  margin-top: 20px;
  padding: 15px;
  border-radius: 50px;
  background: #111;
  border: 1px solid #E30613;
}

.routes {
  position: absolute;
  width: 100%;
  height: 300px;
  top: 0;
  left: 0;
}

.pulse {
  width: 10px;
  height: 10px;
  background: #E30613;
  border-radius: 50%;
  position: absolute;
  top: 150px;
  left: 200px;
  opacity: 0;
  box-shadow: 0 0 20px #E30613;
}

.agent-ring {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  border: 2px solid #E30613;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 25px #E30613;
}

.agent-ring span {
  font-size: 12px;
  margin-top: 6px;
}

.agent-ring.idle {
  border-color: gray;
  box-shadow: none;
}

.agent-ring.working {
  border-color: orange;
  box-shadow: 0 0 25px orange;
}

.agent-ring.failed {
  border-color: red;
  box-shadow: 0 0 25px red;
}

.metrics-container {
  display: flex;
  gap: 40px;
  margin-top: 80px;
}

.metrics-grid {
  display: flex;
  gap: 20px;
  flex: 2;
}

.metric-card {
  background: #111;
  border: 1px solid #E30613;
  padding: 20px;
  flex: 1;
}

.summary {
  background: #111;
  border: 1px solid #E30613;
  padding: 20px;
  flex: 1;
}
