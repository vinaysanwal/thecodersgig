  margin: 8,
  textAlign: 'center',
  minWidth: 120,
  display: 'inline-block',
};

const OrchestratorStatusCard = () => (
  <Card title="OrchestratorStatusCard">
    <div style={{ textAlign: 'center' }}>
      <div style={boxStyle}>start</div>
      <div style={boxStyle}>request queue A</div>
      <div style={boxStyle}>response queue A</div>
    </div>
    <div style={{ marginTop: 16, textAlign: 'center' }}>
      <div style={{ ...boxStyle, borderColor: '#1890ff' }}>→ Agent A</div>
      <div style={{ ...boxStyle, borderColor: '#1890ff' }}>→ Agent B</div>
