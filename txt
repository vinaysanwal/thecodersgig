import { useNavigate } from "react-router-dom";
import { useEffect, useState } from "react";
import "../styles/landing.css";

const AGENTS = [
  "Observability Agent",
  "Brokerage Agent",
  "Disclosure Agent",
  "Compliance Agent",
  "Risk Agent",
  "Analytics Agent",
  "Audit Agent",
  "Orchestration Agent",
];

export default function Landing() {
  const navigate = useNavigate();
  const [stats, setStats] = useState([]);

  useEffect(() => {
    const generateStats = () =>
      AGENTS.map(() => ({
        running: Math.floor(Math.random() * 10) + 1,
        queue: Math.floor(Math.random() * 20),
        success: Math.floor(Math.random() * 10) + 90,
      }));

    setStats(generateStats());

    const interval = setInterval(() => {
      setStats(generateStats());
    }, 3000);

    return () => clearInterval(interval);
  }, []);

  return (
    <div className="landing-wrapper">
      <h1 className="ease-header">EASE</h1>

      <div className="agent-grid">
        {AGENTS.map((agent, index) => (
          <div
            key={agent}
            className={`agent-card theme-${index}`}
            onClick={() => navigate("/observability")}
          >
            <div className="agent-title">{agent}</div>

            {/* COOL ANIMATED AGENT CORE */}
            <div className="ai-icon">
              <div className="energy-ring"></div>
              <div className="energy-ring delay"></div>
              <div className="orbit-dot"></div>
              <div className="core"></div>
            </div>

            {stats[index] && (
              <div className="agent-stats">
                <div className="stat">
                  <span>{stats[index].running}</span>
                  <label>Running</label>
                </div>
                <div className="stat">
                  <span>{stats[index].queue}</span>
                  <label>Queue</label>
                </div>
                <div className="stat">
                  <span>{stats[index].success}%</span>
                  <label>Success</label>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  );
}







