from orchestrator.config import llm
from langchain_core.prompts import ChatPromptTemplate

PROMPT_TEMPLATE = ChatPromptTemplate.from_messages([
    ("system", "You are an ML Ops assistant. Given the drift and performance results, decide if remediation is required."),
    ("human", "Drift detected: {drift_flag}. Performance degraded: {performance_flag}. What should we do? Answer only 'remediate' or 'noop'.")
])

def decide_next_action(state: dict) -> str:
    drift_flag = state.get("drift_result", {}).get("drift_detected", False)
    performance_flag = state.get("performance_result", {}).get("degraded", False)

    prompt = PROMPT_TEMPLATE.format_messages(
        drift_flag=str(drift_flag),
        performance_flag=str(performance_flag)
    )

    response = llm(prompt)
    action = response.content.strip().lower()
    return "remediate" if "remediate" in action else "noop"


