/* ===================================== */
/* FULLSCREEN FIX (CRITICAL) */
/* ===================================== */

html,
body,
#root {
  margin: 0;
  padding: 0;
  height: 100%;
  width: 100%;
}

/* ===================================== */
/* PAGE WRAPPER */
/* ===================================== */

.flow-page {
  height: 100vh;
  width: 100vw;
  background: linear-gradient(135deg, #0f172a, #111827);
  display: flex;
}

/* IMPORTANT — THIS IS WHAT FIXES ERROR #004 */
.flow-container {
  flex: 1;
  height: 100%;
}

/* ===================================== */
/* FLOW NODES */
/* ===================================== */

.flow-node {
  padding: 16px 20px;
  width: 190px;
  border-radius: 14px;
  background: rgba(30, 41, 59, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.3);
  color: #e5e7eb;
  font-weight: 500;
  text-align: center;
  transition: 0.3s ease;
}

.flow-node:hover {
  border-color: #0ea5e9;
  box-shadow: 0 0 20px rgba(14, 165, 233, 0.4);
  transform: translateY(-4px);
}

.clickable-node {
  cursor: pointer;
}

/* ===================================== */
/* EASE CORE */
/* ===================================== */

.ease-node {
  background: transparent !important;
  border: none !important;
}

.ease-core {
  position: relative;
  width: 180px;
  height: 180px;
}

.ease-core-ring {
  position: absolute;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  border: 2px solid rgba(14, 165, 233, 0.4);
  animation: rotateRing 15s linear infinite;
}

@keyframes rotateRing {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.ease-core-inner {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(circle, #0ea5e9, #0369a1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  font-weight: 600;
  color: white;
  box-shadow: 0 0 40px rgba(14, 165, 233, 0.6);
  animation: pulseCore 3s infinite ease-in-out;
}

@keyframes pulseCore {
  0% { box-shadow: 0 0 25px rgba(14,165,233,0.4); }
  50% { box-shadow: 0 0 60px rgba(14,165,233,0.9); }
  100% { box-shadow: 0 0 25px rgba(14,165,233,0.4); }
}

/* ===================================== */
/* EDGES */
/* ===================================== */

.react-flow__edge-path {
  stroke: rgba(14, 165, 233, 0.8);
  stroke-width: 2;
}

.react-flow__edge.animated path {
  stroke-dasharray: 6;
  animation: edgeFlow 1.2s linear infinite;
}

@keyframes edgeFlow {
  to { stroke-dashoffset: -12; }
}

.react-flow__arrowhead path {
  fill: rgba(14, 165, 233, 0.8);
}

/* ===================================== */
/* CONTROLS */
/* ===================================== */

.react-flow__controls {
  background: rgba(17, 24, 39, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.3);
}
