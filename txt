import React, { useMemo } from "react";
import ReactFlow, {
  Background,
  Controls,
  MiniMap,
  Position,
  Handle,
  MarkerType
} from "reactflow";
import "reactflow/dist/style.css";
import "./Home.css";

/* ===========================
   Custom Node Components
=========================== */

const GlassNode = ({ data }) => (
  <div className="glass-node">
    <Handle type="target" position={Position.Left} />
    <div>{data.label}</div>
    <Handle type="source" position={Position.Right} />
  </div>
);

const CircleNode = ({ data }) => (
  <div className={`circle-node ${data.status || ""}`}>
    <Handle type="target" position={Position.Left} />
    <div className="circle-inner">
      <div className="circle-icon">{data.icon}</div>
      <div className="circle-label">{data.label}</div>
      {data.status && <span className="circle-status">{data.status}</span>}
    </div>
    <Handle type="source" position={Position.Right} />
  </div>
);

