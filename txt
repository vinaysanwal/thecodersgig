import React, { useCallback, useState, useEffect } from 'react';
import ReactFlow, {
  Background,
  Controls,
  MiniMap,
  useNodesState,
  useEdgesState,
  addEdge,
  MarkerType
} from 'react-flow-renderer';
import { Card } from 'antd';

const initialNodes = [
  { id: 'Start', position: { x: 0, y: 0 }, data: { label: 'Start' }, type: 'customNode' },
  { id: 'TopicRequestA', position: { x: 180, y: 0 }, data: { label: 'Topic Request A' }, type: 'customNode' },
  { id: 'Orchestrator1', position: { x: 380, y: 0 }, data: { label: 'Orchestrator' }, type: 'customNode' },
  { id: 'TopicRequestAgent', position: { x: 580, y: 0 }, data: { label: 'Topic Request Agent' }, type: 'customNode' },
  { id: 'MainAgent', position: { x: 780, y: 0 }, data: { label: 'Main Agent' }, type: 'customNode' },
  { id: 'TopicResponseAgent', position: { x: 580, y: 150 }, data: { label: 'Topic Response Agent' }, type: 'customNode' },
  { id: 'Orchestrator2', position: { x: 380, y: 150 }, data: { label: 'Orchestrator' }, type: 'customNode' },
  { id: 'TopicResponseA', position: { x: 180, y: 150 }, data: { label: 'Topic Response A' }, type: 'customNode' }
];

const path = [
  'Start',
  'TopicRequestA',
  'Orchestrator1',
  'TopicRequestAgent',
  'MainAgent',
  'TopicResponseAgent',
  'Orchestrator2',
  'TopicResponseA',
  'Start'
];

const initialEdges = [];

const CustomNode = ({ data, isActive, isCompleted }) => {
  const bgColor = isActive ? '#52c41a' : isCompleted ? '#ff4d4f' : '#d9d9d9';

  return (
    <Card
      size="small"
      style={{
        width: 120,
        textAlign: 'center',
        border: `2px solid ${bgColor}`,
        backgroundColor: '#fff',
        borderRadius: 6,
        boxShadow: '0 2px 4px rgba(0,0,0,0.15)',
        position: 'relative'
      }}
    >
      <div
        style={{
          width: 12,
          height: 12,
          backgroundColor: bgColor,
          position: 'absolute',
          top: 6,
          right: 6,
          borderRadius: '50%'
        }}
      />
      {data.label}
    </Card>
  );
};

const nodeTypes = {
  customNode: CustomNode
};

const OrchestratorFlow = () => {
  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes);
  const [edges, setEdges, onEdgesChange] = useEdgesState(initialEdges);
  const [activeIndex, setActiveIndex] = useState(-1);

  const resetFlow = () => {
    setNodes((nds) =>
      nds.map((node) => ({
        ...node,
        data: {
          ...node.data,
          isActive: false,
          isCompleted: false
        }
      }))
    );
    setEdges([]);
    setActiveIndex(-1);
  };

  const triggerFlow = () => {
    resetFlow();

    let i = 0;
    const interval = setInterval(() => {
      if (i >= path.length) {
        clearInterval(interval);
        return;
      }

      const current = path[i];
      const prev = path[i - 1];

      setNodes((nds) =>
        nds.map((node) => {
          if (node.id === current) {
            return {
              ...node,
              data: { ...node.data, isActive: true, isCompleted: false }
            };
          } else if (node.id === prev) {
            return {
              ...node,
              data: { ...node.data, isActive: false, isCompleted: true }
            };
          }
          return node;
        })
      );

      if (i > 0) {
        const from = path[i - 1];
        const to = path[i];
        setEdges((eds) => [
          ...eds,
          {
            id: `${from}->${to}`,
            source: from,
            target: to,
            type: 'default',
            markerEnd: { type: MarkerType.ArrowClosed },
            style: { stroke: '#ff4d4f', strokeWidth: 2 },
            animated: false
          }
        ]);
      }

      i++;
    }, 3000);
  };

  const onNodeClick = useCallback((event, node) => {
    if (node.id === 'Start') {
      triggerFlow();
    }
  }, []);

  return (
    <div style={{ width: '100%', height: '700px' }}>
      <ReactFlow
        nodes={nodes}
        edges={edges}
        onNodesChange={onNodesChange}
        onEdgesChange={onEdgesChange}
        onNodeClick={onNodeClick}
        nodeTypes={nodeTypes}
        fitView
      >
        <Background color="#f0f2f5" gap={16} />
        <MiniMap />
        <Controls />
      </ReactFlow>
    </div>
  );
};

export default OrchestratorFlow;
