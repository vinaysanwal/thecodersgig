<div
  key={agent}
  className="agent-card"
  onClick={() => navigate("/observability")}
>
  <div className="agent-title">{agent}</div>

  {/* Animated Icon */}
  <div className="agent-icon-wrapper">
    <div className="agent-ring"></div>
    <div className="agent-core-dot"></div>
  </div>

  {stats[index] && (
    <div className="agent-stats">
      <div className="stat running">
        <span>{stats[index].running}</span>
        <label>Running</label>
      </div>
      <div className="stat queue">
        <span>{stats[index].queue}</span>
        <label>Queue</label>
      </div>
      <div className="stat success">
        <span>{stats[index].success}%</span>
        <label>Success</label>
      </div>
    </div>
  )}
</div>


/* ============================= */
/* ANIMATED AGENT ICON */
/* ============================= */

.agent-icon-wrapper {
  position: relative;
  width: 70px;
  height: 70px;
  margin: 15px auto;
}

/* Rotating ring */
.agent-ring {
  position: absolute;
  width: 70px;
  height: 70px;
  border-radius: 50%;
  border: 2px solid rgba(0, 255, 255, 0.6);
  box-shadow: 0 0 15px rgba(0, 255, 255, 0.8);
  animation: rotateRing 4s linear infinite;
}

/* Core glowing dot */
.agent-core-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18px;
  height: 18px;
  background: #00ffff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 15px #00ffff,
              0 0 30px rgba(0,255,255,0.7);
  animation: pulseCore 2s infinite ease-in-out;
}

/* Ring rotation */
@keyframes rotateRing {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Core pulse */
@keyframes pulseCore {
  0% { transform: translate(-50%, -50%) scale(1); }
  50% { transform: translate(-50%, -50%) scale(1.3); }
  100% { transform: translate(-50%, -50%) scale(1); }
}
