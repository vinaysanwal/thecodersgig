const [guardrailError, setGuardrailError] = useState(null);


const handleRunEvaluation = async () => {
  setGuardrailError(null);
  try {
    const res = await runOrchestrator(selectedModel);
    message.success('✅ Evaluation complete!');
    fetchData();
  } catch (err) {
    const errorMsg =
      err?.response?.data?.error || 'Unknown error occurred during orchestration.';
    setGuardrailError(errorMsg);
    message.error(`❌ Guardrail triggered: ${errorMsg}`);
  }
};


{guardrailError && (
  <Alert
    message="Guardrail Violation"
    description={guardrailError}
    type="error"
    showIcon
    closable
    style={{ marginBottom: 20 }}
  />
)}
