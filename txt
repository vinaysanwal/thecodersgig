import React, { useEffect, useState } from 'react';
import { Table, Typography, Layout, Spin } from 'antd';
import Header from '../components/Header';
import { getDriftData } from '../services/api';

const { Title } = Typography;
const { Content } = Layout;

const DriftDetection = () => {
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    getDriftData().then((res) => {
      setData(res.data);
      setLoading(false);
    });
  }, []);

  const columns = [
    { title: 'Feature', dataIndex: 'feature' },
    { title: 'Drift Score', dataIndex: 'score' },
    { title: 'Status', dataIndex: 'status' }
  ];

  const tableData = data?.drift_features?.map((feature, index) => ({
    key: index,
    feature,
    score: data?.drift_scores?.[feature]?.toFixed(2),
    status: 'Drift'
  })) || [];

  return (
    <Layout>
      <Header />
      <Content style={{ padding: '24px' }}>
        <Title level={3}>Drift Detection</Title>
        {loading ? <Spin /> : <Table columns={columns} dataSource={tableData} />}
      </Content>
    </Layout>
  );
};

export default DriftDetection;



